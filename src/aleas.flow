import embryo.rng { rng_real }

extern {
    function calloc(count: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>)
    function sqrt(x: f64) -> f64
    function cos(x: f64) -> f64
    function sin(x: f64) -> f64
}

const PI_SINGLE_ASSIGNED_TO_DOUBLE: f64 = (3.141592 as f32) as f64
const PARTITION_STRIDE: i32 = 4

let mut nvalo: i32 = 0
let mut nvaloq: i32 = 0
let mut particions_esfera: ptr<f64> = null

function partition_index(row: i32, column: i32) -> i32 {
    return row * PARTITION_STRIDE + column
}

# Construct antipodal pairs distributed over the unit sphere.
function inialea3d(un: i32) -> void {
    nvalo = un
    nvaloq = un * un
    if particions_esfera != null { free(particions_esfera as ptr<void>) }
    particions_esfera = calloc(((nvaloq + 1) * PARTITION_STRIDE) as i64, sizeof<f64>()) as ptr<f64>
    let e: f64 = PI_SINGLE_ASSIGNED_TO_DOUBLE
    let half: i32 = nvaloq / 2
    let mut i: i32 = 1
    while i <= half {
        let x: f64 = rng_real()
        let y0: f64 = rng_real()
        let angle: f64 = 2.0 * e * x
        let y: f64 = (2.0 * y0) - 1.0
        let radius: f64 = sqrt(1.0 - (y * y))
        let xx: f64 = radius * cos(angle)
        let yy: f64 = radius * sin(angle)
        particions_esfera[partition_index(i, 1)] = xx
        particions_esfera[partition_index(i, 2)] = yy
        particions_esfera[partition_index(i, 3)] = y
        particions_esfera[partition_index(i + half, 1)] = -1.0 * radius * cos(angle)
        particions_esfera[partition_index(i + half, 2)] = -1.0 * radius * sin(angle)
        particions_esfera[partition_index(i + half, 3)] = -1.0 * y
        i = i + 1
    }
}

export nvalo, nvaloq, particions_esfera, partition_index, inialea3d
