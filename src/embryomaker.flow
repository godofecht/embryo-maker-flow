import embryo.io { read_snapshot_parameters, snapshot_error, write_snapshot }
import embryo.aleas { inialea3d }
import embryo.general { nparti, getot, aut, eva }
import embryo.model { advance_model_iteration, model_error }
import embryo.workers { parallel_init }
import embryo.biomechanic { force_parallel_calls, force_parallel_fallbacks, force_gpu_calls, force_gpu_fallbacks }
import embryo.neighboring { neighbor_gpu_calls, neighbor_gpu_fallbacks }
import embryo.io { format_i64 }
import std.process { proc_argc, proc_argv, proc_getenv }
import std.string { str_parse_i64_at, str_format_i64 }

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function getchar() -> i32
    function fflush(stream: ptr<void>) -> i32
}

function worker_flush() -> void { fflush(null) }

# Verification must observe completed GPU work. CPU fallback is useful in the
# application, but cannot establish GPU parity.
function verify_gpu_execution() -> i32 {
    let required: string = proc_getenv("EMBRYO_GPU_REQUIRED")
    if required == "" { return 0 }
    let neighbors: i32 = neighbor_gpu_calls - neighbor_gpu_fallbacks
    let forces: i32 = force_gpu_calls - force_gpu_fallbacks
    println("GPU completed neighbors=" + format_i64(neighbors as i64) + " forces=" + format_i64(forces as i64))
    if (required == "neighbors" and neighbors > 0) or (required == "forces" and forces > 0) or (required == "any" and neighbors + forces > 0) { return 0 }
    println("GPU verification failed: required work did not execute")
    return 6
}

function run_worker(output_path: string) -> i32 {
    if write_snapshot(output_path) == false { println("ERR snapshot"); worker_flush(); return 5 }
    println("READY")
    worker_flush()
    let mut command: array<u8, 64> = []
    while true {
        let mut length: i32 = 0
        let mut byte: i32 = getchar()
        if byte == -1 { return 0 }
        while byte != -1 and byte != 10 {
            if length < 63 { command[length] = byte as u8; length = length + 1 }
            byte = getchar()
        }
        command[length] = 0
        let requested = str_parse_i64_at(&command[0] as string, 0)
        if requested.ok == false or requested.value < 0 or requested.value > 100000 {
            println("ERR command")
            worker_flush()
            continue
        }
        let mut completed: i64 = 0
        while completed < requested.value {
            if advance_model_iteration() == false {
                let error_text: ptr<u8> = malloc(32) as ptr<u8>
                defer free(error_text as ptr<void>)
                str_format_i64(error_text, 32, model_error as i64)
                println("ERR model " + error_text as string)
                worker_flush()
                return 4
            }
            completed = completed + 1
        }
        if write_snapshot(output_path) == false {
            println("ERR snapshot")
            worker_flush()
            return 5
        }
        let iteration_text: ptr<u8> = malloc(32) as ptr<u8>
        defer free(iteration_text as ptr<void>)
        str_format_i64(iteration_text, 32, getot as i64)
        if verify_gpu_execution() != 0 { return 6 }
        println("OK " + iteration_text as string)
        worker_flush()
    }
    return 0
}

function main() -> i32 {
    let argc: i32 = proc_argc()
    if argc < 2 {
        println("usage: embryomaker <input.txt> [iterations] [output.dat]")
        println("       embryomaker <input.txt> <aut> <iterations_per_snapshot> <snapshots> [output_prefix]")
        println("       embryomaker <input.txt> --worker <snapshot.dat>")
        return 2
    }
    let _threads: i32 = parallel_init()
    let report_stats: bool = proc_getenv("EMBRYO_PARALLEL_STATS") == "1"
    let input_path: string = proc_argv(1)
    let input_status: i32 = read_snapshot_parameters(input_path)
    if input_status != 0 {
        let error_text: ptr<u8> = malloc(32) as ptr<u8>
        defer free(error_text as ptr<void>)
        str_format_i64(error_text, 32, snapshot_error as i64)
        println("could not read EmbryoMaker input, error " + error_text as string + ": " + input_path)
        return 3
    }
    if argc >= 4 and proc_argv(2) == "--worker" {
        inialea3d(nparti)
        return run_worker(proc_argv(3))
    }

    if argc >= 5 {
        let aut_value = str_parse_i64_at(proc_argv(2), 0)
        let interval_value = str_parse_i64_at(proc_argv(3), 0)
        let count_value = str_parse_i64_at(proc_argv(4), 0)
        if aut_value.ok == false or interval_value.ok == false or count_value.ok == false or aut_value.value < -2147483648 or aut_value.value > 2147483647 or interval_value.value < 0 or count_value.value < 0 or interval_value.value > 2147483647 or count_value.value > 2147483647 {
            println("snapshot arguments are outside supported integer ranges")
            return 2
        }
        aut = aut_value.value as i32
        eva = if aut == 5 { 1 } else { 0 }
        inialea3d(nparti)
        let interval: i32 = interval_value.value as i32
        let snapshot_count: i32 = count_value.value as i32
        let output_prefix: string = if argc >= 6 { proc_argv(5) } else { "flow_snapshot" }
        let mut snapshot: i32 = 0
        while snapshot < snapshot_count {
            let mut iteration: i32 = 0
            while iteration < interval {
                if advance_model_iteration() == false {
                    let error_text: ptr<u8> = malloc(32) as ptr<u8>
                    defer free(error_text as ptr<void>)
                    str_format_i64(error_text, 32, model_error as i64)
                    println("simulation stopped during model iteration, error " + error_text as string)
                    return 4
                }
                iteration = iteration + 1
            }
            let number: ptr<u8> = malloc(32) as ptr<u8>
            defer free(number as ptr<void>)
            str_format_i64(number, 32, getot as i64)
            let output_path: string = output_prefix + "_" + (number as string) + ".dat"
            if write_snapshot(output_path) == false {
                println("could not write snapshot: " + output_path)
                return 5
            }
            snapshot = snapshot + 1
        }
        return verify_gpu_execution()
    }

    inialea3d(nparti)
    let mut iterations: i32 = 1
    if argc >= 3 {
        let parsed = str_parse_i64_at(proc_argv(2), 0)
        if parsed.ok == false or parsed.value < 0 or parsed.value > 2147483647 {
            println("iterations must be a nonnegative integer")
            return 2
        }
        iterations = parsed.value as i32
    }
    let output_path: string = if argc >= 4 { proc_argv(3) } else { "flow_snapshot.dat" }
    let mut iteration: i32 = 0
    while iteration < iterations {
        if advance_model_iteration() == false {
            let error_text: ptr<u8> = malloc(32) as ptr<u8>
            defer free(error_text as ptr<void>)
            str_format_i64(error_text, 32, model_error as i64)
            println("simulation stopped during model iteration, error " + error_text as string)
            return 4
        }
        iteration = iteration + 1
    }
    if write_snapshot(output_path) == false {
        println("could not write snapshot: " + output_path)
        return 5
    }
    return verify_gpu_execution()
}
