struct Nod {
    x: f64, y: f64, z: f64, e: f64,
    eqd: f64, add: f64, you: f64, adh: f64, rep: f64, rec: f64,
    erp: f64, est: f64, eqs: f64, hoo: f64, mov: f64, dmo: f64,
    orix: f64, oriy: f64, oriz: f64, ecm: f64, cod: f64, grd: f64,
    pld: f64, vod: f64, dif: f64, kfi: f64, pla: f64, kvol: f64,
    tipus: i32, icel: i32, altre: i32, marge: i32, talone: i32,
    fix: i32, ndiv: i32
}

struct Cel {
    minsize_for_div: f64, maxsize_for_div: f64,
    cex: f64, cey: f64, cez: f64,
    polx: f64, poly: f64, polz: f64,
    hpolx: f64, hpoly: f64, hpolz: f64,
    fase: f64, temt: f64,
    nunodes: i32, nodela: i32, ctipus: i32,
    node: ptr<i32>
}

