export delta, rtime, temp, rv, urv, prop_noise, reqmin, ecmmax, mmae, dmax, prec, dif_req, min_comp
export mnn, ramax, deltamax, deltamin, desmax, resmax, nparti, movi, ttalone, khold, screen_radius, df_reqmax, angletor, ldi, ndmax, ndch, whichend, eva
export i, j, k, ii, jj, kk, iii, jjj, kkk, iiii, jjjj, kkkk, iiiii, jjjjj, kkkkk
export a, b, c, d, e, f, g, h, aa, bb, cc, dd, ee, ff, gg, hh, aaa, bbb, ccc, ddd, eee, fff, ggg, hhh
export Nod, Cel, nod_zero, cel_zero, iniarrays, resize_node_buffers, resize_cell_buffers, remove_node_slot, node, nodeo, cels, node_capacity, cell_capacity
