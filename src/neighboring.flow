extern {
    function embryo_candidates_enabled() -> i32
    function embryo_candidates_reset()
    function embryo_candidates_prepare(n: i32, geometry: ptr<f64>, scale: f64, side: i32,
        heads: ptr<i32>, epochs: ptr<i32>, epoch: i32, next: ptr<i32>) -> i32
    function embryo_candidates_offsets() -> ptr<i32>
    function embryo_candidates_ends() -> ptr<i32>
    function embryo_candidates_ids() -> ptr<i32>
    function calloc(count: i64, size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function free(p: ptr<void>)
    function memset(p: ptr<void>, value: i32, size: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, size: i64) -> ptr<void>
