import embryo.general { ncels, cels, node }
import embryo.genetic { node_gene_effect }
import embryo.aleas { nvaloq, particions_esfera, partition_index }
import embryo.rng { rng_real }

extern {
    function sqrt(x: f64) -> f64
}

const PARAMETER_NODE_POLARIZATION: i32 = 43
const POLARIZATION_EPSILOD: f64 = 2.2204460492503131e-15

function polarization() -> bool {
    for cell_id in 1 to ncels + 1 {
        let node_count: i32 = cels[cell_id].nunodes
        if node_count <= 0 { continue }
        let center_x: f64 = cels[cell_id].cex
        let center_y: f64 = cels[cell_id].cey
        let center_z: f64 = cels[cell_id].cez
        let mut center_node: i32 = 0
        let mut closest: f64 = 1.0e10
        # The Fortran routine leaves d undefined on ignored node types. Use
        # the nearest eligible surface node as its documented intent.
        let mut last_distance: f64 = 1.0e10
        for slot in 1 to node_count + 1 {
            let node_id: i32 = cels[cell_id].node[slot]
            if node[node_id].tipus == 1 or node[node_id].tipus == 3 {
                let dx: f64 = node[node_id].x - center_x
                let dy: f64 = node[node_id].y - center_y
                let dz: f64 = node[node_id].z - center_z
                last_distance = sqrt((dx * dx) + (dy * dy) + (dz * dz))
            }
            if last_distance <= closest { closest = last_distance; center_node = node_id }
        }
        if center_node == 0 { return false }
        let property: i32 = PARAMETER_NODE_POLARIZATION
        let center_signal: f64 = node_gene_effect(center_node, property)

        let mut gradient_x: f64 = 0.0
        let mut gradient_y: f64 = 0.0
        let mut gradient_z: f64 = 0.0
        for slot in 1 to node_count + 1 {
            let node_id: i32 = cels[cell_id].node[slot]
            if node[node_id].tipus == 1 or node[node_id].tipus == 3 {
                let dx: f64 = node[node_id].x - center_x
                let dy: f64 = node[node_id].y - center_y
                let dz: f64 = node[node_id].z - center_z
                let radius: f64 = sqrt((dx * dx) + (dy * dy) + (dz * dz))
                if radius >= POLARIZATION_EPSILOD {
                    let inverse_radius: f64 = 1.0 / radius
                    let signal: f64 = node_gene_effect(node_id, property)
                    gradient_x = gradient_x + (dx * inverse_radius) * (signal - center_signal)
                    gradient_y = gradient_y + (dy * inverse_radius) * (signal - center_signal)
                    gradient_z = gradient_z + (dz * inverse_radius) * (signal - center_signal)
                }
            }
        }

        if gradient_x == 0.0 and gradient_y == 0.0 and gradient_z == 0.0 {
            if nvaloq <= 0 or particions_esfera == null { return false }
            let random_value: f64 = rng_real()
            let partition: i32 = ((random_value * nvaloq as f64) as i32) + 1
            cels[cell_id].polx = particions_esfera[partition_index(partition, 1)]
            cels[cell_id].poly = particions_esfera[partition_index(partition, 2)]
            cels[cell_id].polz = particions_esfera[partition_index(partition, 3)]
        } else {
            let magnitude_squared: f64 = (gradient_x * gradient_x) + (gradient_y * gradient_y) + (gradient_z * gradient_z)
            if magnitude_squared == 0.0 {
                cels[cell_id].polx = 0.0; cels[cell_id].poly = 0.0; cels[cell_id].polz = 0.0
            } else {
                let inverse_magnitude: f64 = 1.0 / sqrt(magnitude_squared)
                cels[cell_id].polx = gradient_x * inverse_magnitude
                cels[cell_id].poly = gradient_y * inverse_magnitude
                cels[cell_id].polz = gradient_z * inverse_magnitude
            }
        }
    }
    return true
}

export polarization
