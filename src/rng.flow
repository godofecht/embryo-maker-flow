# GFortran 15 random_number uses xoshiro256**. Unsigned words make the
# generator's wraparound arithmetic explicit in Flow.
let mut state0_low: i32 = 0
let mut state0_high: i32 = 0
let mut state1_low: i32 = 0
let mut state1_high: i32 = 0
let mut state2_low: i32 = 0
let mut state2_high: i32 = 0
let mut state3_low: i32 = 0
let mut state3_high: i32 = 0

function state_word(index: i32) -> u64 {
    let mut low: i32 = state3_low
    let mut high: i32 = state3_high
    if index == 0 { low = state0_low; high = state0_high }
    elif index == 1 { low = state1_low; high = state1_high }
    elif index == 2 { low = state2_low; high = state2_high }
    return ((high as u32 as u64) << 32) | (low as u32 as u64)
}

function set_state_word(index: i32, value: u64) -> void {
    let low: i32 = value as u32 as i32
    let high: i32 = (value >> 32) as u32 as i32
    if index == 0 { state0_low = low; state0_high = high }
    elif index == 1 { state1_low = low; state1_high = high }
    elif index == 2 { state2_low = low; state2_high = high }
    else { state3_low = low; state3_high = high }
}

function seed_key(index: i32) -> u64 {
    if index == 0 { return 0xbd0c5b6e50c2df49 }
    if index == 1 { return 0xd46061cd46e1df38 }
    if index == 2 { return 0xbb4f4d4ed6103544 }
    return 0x114a583d0756ad39
}

function rotl64(value: u64, shift: i32) -> u64 {
    return (value << shift) | (value >> (64 - shift))
}

function next_u64() -> u64 {
    let s0: u64 = state_word(0)
    let s1: u64 = state_word(1)
    let s2: u64 = state_word(2)
    let s3: u64 = state_word(3)
    let result: u64 = rotl64(s1 * 5, 7) * 9
    let t: u64 = s1 << 17
    set_state_word(2, s2 ^ s0)
    set_state_word(3, s3 ^ s1)
    set_state_word(1, s1 ^ state_word(2))
    set_state_word(0, s0 ^ state_word(3))
    set_state_word(2, state_word(2) ^ t)
    set_state_word(3, rotl64(state_word(3), 45))
    return result
}

# GFortran stores each word as high then low 32-bit seed elements. The input
# order is reversed, and each word is XORed with its fixed initialization key.
function rng_seed(seed: ptr<i32>, count: i32) -> void {
    for word in 0 to 4 {
        let low_index: i32 = 7 - word * 2
        let high_index: i32 = 6 - word * 2
        let mut low: i32 = 0
        let mut high: i32 = 0
        if low_index < count { low = seed[low_index] }
        if high_index < count { high = seed[high_index] }
        let bits: u64 = ((high as u32 as u64) << 32) | (low as u32 as u64)
        set_state_word(word, bits ^ seed_key(word))
    }
}

function rng_real() -> f64 {
    return ((next_u64() >> 11) as f64) * 1.1102230246251565e-16
}

function rng_get(seed: ptr<i32>, count: i32) -> void {
    for word in 0 to 4 {
        let bits: u64 = state_word(word) ^ seed_key(word)
        let low_index: i32 = 7 - word * 2
        let high_index: i32 = 6 - word * 2
        if low_index < count { seed[low_index] = bits as u32 as i32 }
        if high_index < count { seed[high_index] = (bits >> 32) as u32 as i32 }
    }
}

export rng_seed, rng_real, rng_get
