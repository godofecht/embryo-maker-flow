import embryo.aleas { particions_esfera, partition_index, inialea3d }
import embryo.rng { rng_seed }

function main() -> i32 {
    let mut seed: array<i32, 8> = [1, 2, 3, 4, 5, 6, 7, 8]
    rng_seed(&seed[0], 8)
    inialea3d(2)
    let x: f64 = particions_esfera[partition_index(1, 1)]
    let y: f64 = particions_esfera[partition_index(1, 2)]
    let z: f64 = particions_esfera[partition_index(1, 3)]
    let ox: f64 = particions_esfera[partition_index(3, 1)]
    let oy: f64 = particions_esfera[partition_index(3, 2)]
    let oz: f64 = particions_esfera[partition_index(3, 3)]
    if x != -0.633057516217030436 { return 5 }
    if y != 0.116353525863234858 { return 6 }
    if z != -0.765310419490233818 { return 7 }
    if x + ox < -1e-15 || x + ox > 1e-15 { return 1 }
    if y + oy < -1e-15 || y + oy > 1e-15 { return 2 }
    if z + oz < -1e-15 || z + oz > 1e-15 { return 3 }
    if x * x + y * y + z * z < 0.999999999999 || x * x + y * y + z * z > 1.000000000001 { return 4 }
    return 0
}
