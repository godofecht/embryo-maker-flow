import embryo.io { read_snapshot_parameters }
import embryo.aleas { inialea3d }
import embryo.general { nd, node, nparti }
import embryo.model { advance_model_iteration, model_error }
import std.io { FileRead, io_read_file }
import std.string { ParseI64, ParseF64, str_parse_i64_at, str_parse_f64_at }

const OG_TIME_ONE_ITERATIONS: i32 = 177

extern {
    function malloc(size: i64) -> ptr<void>
    function fabs(value: f64) -> f64
}

function line_end(data: string, length: i32, start: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = start
    while cursor < length and bytes[cursor] != 10 and bytes[cursor] != 13 { cursor = cursor + 1 }
    return cursor
}

function line_next(data: string, length: i32, end: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = end
    if cursor < length and bytes[cursor] == 13 { cursor = cursor + 1 }
    if cursor < length and bytes[cursor] == 10 { cursor = cursor + 1 }
    return cursor
}

function copy_line(data: string, start: i32, end: i32) -> string {
    let bytes: ptr<u8> = data as ptr<u8>
    let line: ptr<u8> = malloc((end - start + 1) as i64) as ptr<u8>
    let mut source: i32 = start
    let mut target: i32 = 0
    while source < end { line[target] = bytes[source]; source = source + 1; target = target + 1 }
    line[target] = 0
    return line as string
}

function main() -> i32 {
    if read_snapshot_parameters("../reference/examples/blastula-like_initial_conditions/Epithelial_blastula.dat") != 0 { return 1 }
    if nd != 744 { return 2 }
    inialea3d(nparti)
    let mut iteration: i32 = 0
    while iteration < OG_TIME_ONE_ITERATIONS {
        if advance_model_iteration() == false { println(iteration, model_error); return 3 }
        iteration = iteration + 1
    }

    let expected: FileRead = io_read_file("fixtures/blastula_og_time1_positions.ref")
    if expected.ok == false { return 4 }
    let mut cursor: i32 = 0
    let mut node_id: i32 = 1
    while node_id <= nd {
        let end: i32 = line_end(expected.data, expected.len as i32, cursor)
        let line: string = copy_line(expected.data, cursor, end)
        let id: ParseI64 = str_parse_i64_at(line, 0)
        let x: ParseF64 = str_parse_f64_at(line, id.end)
        let y: ParseF64 = str_parse_f64_at(line, x.end)
        let z: ParseF64 = str_parse_f64_at(line, y.end)
        if id.ok == false or x.ok == false or y.ok == false or z.ok == false or id.value != node_id as i64 { return 5 }
        if fabs(node[node_id].x - x.value) > 1.0e-9 or fabs(node[node_id].y - y.value) > 1.0e-9 or fabs(node[node_id].z - z.value) > 1.0e-9 {
            println(node_id, node[node_id].x, node[node_id].y, node[node_id].z, x.value, y.value, z.value)
            return 6
        }
        cursor = line_next(expected.data, expected.len as i32, end)
        node_id = node_id + 1
    }
    return 0
}
