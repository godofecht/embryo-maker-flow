import embryo.io { read_snapshot_parameters }
import embryo.general { ncels, cels }
import embryo.nexus { change_minsize_for_div, change_maxsize_for_div }
import std.io { FileRead, io_read_file }
import std.string { ParseI64, ParseF64, str_parse_i64_at, str_parse_f64_at }

extern {
    function malloc(size: i64) -> ptr<void>
    function fabs(x: f64) -> f64
}

function line_end(data: string, length: i32, start: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = start
    while cursor < length and bytes[cursor] != 10 and bytes[cursor] != 13 { cursor = cursor + 1 }
    return cursor
}

function line_next(data: string, length: i32, end: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = end
    if cursor < length and bytes[cursor] == 13 { cursor = cursor + 1 }
    if cursor < length and bytes[cursor] == 10 { cursor = cursor + 1 }
    return cursor
}

function copy_line(data: string, start: i32, end: i32) -> string {
    let bytes: ptr<u8> = data as ptr<u8>
    let line: ptr<u8> = malloc((end - start + 1) as i64) as ptr<u8>
    let mut source: i32 = start
    let mut target: i32 = 0
    while source < end { line[target] = bytes[source]; source = source + 1; target = target + 1 }
    line[target] = 0
    return line as string
}

function close_f64(actual: f64, expected: f64) -> bool {
    let scale: f64 = if fabs(expected) > 1.0 { fabs(expected) } else { 1.0 }
    return fabs(actual - expected) <= 1.0e-9 * scale
}

function check_cell_control(input_path: string, fixture_path: string) -> i32 {
    if read_snapshot_parameters(input_path) != 0 { return 1 }
    if change_minsize_for_div() == false { return 2 }
    if change_maxsize_for_div() == false { return 3 }
    let reference: FileRead = io_read_file(fixture_path)
    if reference.ok == false { return 4 }
    let mut cursor: i32 = 0
    let mut cell_id: i32 = 1
    while cell_id <= ncels {
        let end: i32 = line_end(reference.data, reference.len as i32, cursor)
        let line: string = copy_line(reference.data, cursor, end)
        let id: ParseI64 = str_parse_i64_at(line, 0)
        let minimum: ParseF64 = str_parse_f64_at(line, id.end)
        let maximum: ParseF64 = str_parse_f64_at(line, minimum.end)
        if id.ok == false or minimum.ok == false or maximum.ok == false or id.value != cell_id as i64 { return 5 }
        if close_f64(cels[cell_id].minsize_for_div, minimum.value) == false { return 6 }
        if close_f64(cels[cell_id].maxsize_for_div, maximum.value) == false { return 7 }
        cursor = line_next(reference.data, reference.len as i32, end)
        cell_id = cell_id + 1
    }
    if cursor < reference.len as i32 { return 8 }
    return 0
}

function main() -> i32 {
    let migration: i32 = check_cell_control("../reference/examples/migration/migration.txt", "fixtures/migration_cell_control.ref")
    if migration != 0 { return migration }
    let apoptosis: i32 = check_cell_control("../reference/examples/apoptosis/apoptosis.txt", "fixtures/apoptosis_cell_control.ref")
    if apoptosis != 0 { return apoptosis }
    let adhesion: i32 = check_cell_control("../reference/examples/differential_adhesion/differential_adhesion.txt", "fixtures/differential_adhesion_cell_control.ref")
    if adhesion != 0 { return adhesion }
    let polar_growth: i32 = check_cell_control("../reference/examples/polar_growth/polar_growth.txt", "fixtures/polar_growth_cell_control.ref")
    if polar_growth != 0 { return polar_growth }
    let apical: i32 = check_cell_control("../reference/examples/apical_contraction/apical_contraction.txt", "fixtures/apical_contraction_cell_control.ref")
    if apical != 0 { return apical }
    let ecm: i32 = check_cell_control("../reference/examples/ecm_secretion/ecm_secretion.txt", "fixtures/ecm_secretion_cell_control.ref")
    if ecm != 0 { return ecm }
    let figure_six: i32 = check_cell_control("../reference/examples/figure_6/gastrula.txt", "fixtures/figure_6_cell_control.ref")
    if figure_six != 0 { return figure_six }
    return check_cell_control("../reference/examples/sea_urchin_gastrulation/sea_urchin.txt", "fixtures/sea_urchin_cell_control.ref")
}
