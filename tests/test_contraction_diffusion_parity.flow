import embryo.io { read_snapshot_parameters }
import embryo.general { nd, node, delta, dif_req }
import embryo.neighboring { neighbor_build }
import embryo.nexus { diffusion_of_reqcr }
import std.io { FileRead, io_read_file }
import std.string { ParseI64, ParseF64, str_parse_i64_at, str_parse_f64_at }

extern {
    function fabs(x: f64) -> f64
    function malloc(size: i64) -> ptr<void>
}

function check(path: string, fixture: string) -> i32 {
    if read_snapshot_parameters(path) != 0 { return 1 }
    if neighbor_build() == false { return 2 }
    delta = 0.02
    dif_req = 0.3
    let mut current: i32 = 1
    while current <= nd {
        node[current].grd = (current % 7) as f64 * 0.125
        current = current + 1
    }
    if diffusion_of_reqcr() == false { return 3 }
    let expected: FileRead = io_read_file(fixture)
    if expected.ok == false { return 4 }
    let bytes: ptr<u8> = expected.data as ptr<u8>
    let mut cursor: i32 = 0
    current = 1
    while current <= nd {
        let line: ptr<u8> = malloc((expected.len + 1) as i64) as ptr<u8>
        let mut length: i32 = 0
        while cursor < expected.len as i32 and bytes[cursor] != 10 and bytes[cursor] != 13 {
            line[length] = bytes[cursor]
            cursor = cursor + 1
            length = length + 1
        }
        while cursor < expected.len as i32 and (bytes[cursor] == 10 or bytes[cursor] == 13) { cursor = cursor + 1 }
        line[length] = 0
        let id: ParseI64 = str_parse_i64_at(line as string, 0)
        let value: ParseF64 = str_parse_f64_at(line as string, id.end)
        if id.ok == false or value.ok == false or id.value != current as i64 { return 5 }
        let scale: f64 = if fabs(value.value) > 1.0 { fabs(value.value) } else { 1.0 }
        if fabs(node[current].grd - value.value) > 1.0e-12 * scale { return 6 }
        current = current + 1
    }
    current = 1
    while current <= nd {
        node[current].grd = 2.5
        current = current + 1
    }
    if diffusion_of_reqcr() == false { return 7 }
    current = 1
    while current <= nd {
        if node[current].grd != 2.5 { return 8 }
        current = current + 1
    }
    return 0
}

function main() -> i32 {
    if check("../reference/examples/migration/migration.txt", "fixtures/migration_contraction_diffusion.ref") != 0 { return 1 }
    if check("../reference/examples/apoptosis/apoptosis.txt", "fixtures/apoptosis_contraction_diffusion.ref") != 0 { return 2 }
    if check("../reference/examples/differential_adhesion/differential_adhesion.txt", "fixtures/differential_adhesion_contraction_diffusion.ref") != 0 { return 3 }
    if check("../reference/examples/polar_growth/polar_growth.txt", "fixtures/polar_growth_contraction_diffusion.ref") != 0 { return 4 }
    if check("../reference/examples/ecm_secretion/ecm_secretion.txt", "fixtures/ecm_secretion_contraction_diffusion.ref") != 0 { return 5 }
    return check("../reference/examples/sea_urchin_gastrulation/sea_urchin.txt", "fixtures/sea_urchin_contraction_diffusion.ref")
}
