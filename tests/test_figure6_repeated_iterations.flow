import embryo.io { read_snapshot_parameters }
import embryo.aleas { inialea3d }
import embryo.general { nparti }
import embryo.model { advance_model_iteration, model_error }
import embryo.nexus { nexus_error }
import embryo.ecm { ecm_error }

function main() -> i32 {
    if read_snapshot_parameters("../reference/examples/figure_6/gastrula.txt") != 0 { return 1 }
    inialea3d(nparti)
    let mut iteration: i32 = 1
    while iteration <= 5 {
        if advance_model_iteration() == false { println("model status", model_error, "nexus", nexus_error, "ecm", ecm_error, "iteration", iteration); return 10 + model_error }
        if model_error != 0 { return 20 }
        iteration = iteration + 1
    }
    return 0
}
