import embryo.io { read_snapshot_parameters }
import embryo.general { nd, ncels, cels, node, nodeo, delta, ffu, nparti, extre }
import embryo.growth { should_i_grow, growth_error }
import embryo.aleas { inialea3d }
import embryo.genetic {
    ng, npag, whonpag, gex, agex, gene_effects,
    gene_expression_index, gene_effect_index
}
import std.io { FileRead, io_read_file }
import std.string { ParseI64, ParseF64, str_parse_i64_at, str_parse_f64_at }

extern {
    function malloc(size: i64) -> ptr<void>
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
}

function line_end(data: string, length: i32, start: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = start
    while cursor < length and bytes[cursor] != 10 and bytes[cursor] != 13 { cursor = cursor + 1 }
    return cursor
}

function line_next(data: string, length: i32, end: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = end
    if cursor < length and bytes[cursor] == 13 { cursor = cursor + 1 }
    if cursor < length and bytes[cursor] == 10 { cursor = cursor + 1 }
    return cursor
}

function copy_line(data: string, start: i32, end: i32) -> string {
    let bytes: ptr<u8> = data as ptr<u8>
    let line: ptr<u8> = malloc((end - start + 1) as i64) as ptr<u8>
    let mut source: i32 = start
    let mut target: i32 = 0
    while source < end { line[target] = bytes[source]; source = source + 1; target = target + 1 }
    line[target] = 0
    return line as string
}

function close_f64(actual: f64, expected: f64) -> bool {
    let scale: f64 = if fabs(expected) > 1.0 { fabs(expected) } else { 1.0 }
    return fabs(actual - expected) <= 1.0e-9 * scale
}

function force_growth_input() -> i32 {
    delta = 1.0
    ffu[1] = 1
    npag[36] = 1
    whonpag[36 * (ng + 1) + 1] = 1
    gene_effects[gene_effect_index(1, 36)] = 1.0e8
    npag[44] = 0
    let mut node_id: i32 = 1
    while node_id <= nd {
        gex[gene_expression_index(node_id, 1)] = 0.0
        agex[gene_expression_index(node_id, 1)] = 0.0
        node_id = node_id + 1
    }
    let mut cell_id: i32 = 1
    while cell_id <= ncels and node[cels[cell_id].node[1]].fix != 0 {
        cell_id = cell_id + 1
    }
    if cell_id > ncels { return 1 }
    let parent: i32 = cels[cell_id].node[1]
    let paired: i32 = node[parent].altre
    gex[gene_expression_index(parent, 1)] = 1.0
    agex[gene_expression_index(parent, 1)] = 1.0
    if paired > 0 {
        gex[gene_expression_index(paired, 1)] = 1.0
        agex[gene_expression_index(paired, 1)] = 1.0
    }
    return 0
}

function calculate_extent() -> void {
    extre = 0.0
    let mut node_id: i32 = 1
    while node_id <= nd {
        let distance: f64 = sqrt((node[node_id].x * node[node_id].x) + (node[node_id].y * node[node_id].y) + (node[node_id].z * node[node_id].z))
        if distance > extre { extre = distance }
        node_id = node_id + 1
    }
}

function check_growth_add(input_path: string, fixture_path: string) -> i32 {
    if read_snapshot_parameters(input_path) != 0 { return 1 }
    inialea3d(nparti)
    calculate_extent()
    if force_growth_input() != 0 { return 3 }
    if should_i_grow() == false { return 4 + growth_error }
    let reference: FileRead = io_read_file(fixture_path)
    if reference.ok == false { return 8 }
    let cursor: i32 = 0
    let header_end: i32 = line_end(reference.data, reference.len as i32, cursor)
    let header: string = copy_line(reference.data, cursor, header_end)
    let expected_nodes: ParseI64 = str_parse_i64_at(header, 0)
    let expected_cells: ParseI64 = str_parse_i64_at(header, expected_nodes.end)
    if expected_nodes.ok == false or expected_cells.ok == false or expected_nodes.value != nd as i64 or expected_cells.value != ncels as i64 { return nd % 100 }
    cursor = line_next(reference.data, reference.len as i32, header_end)
    let mut node_id: i32 = 1
    while node_id <= nd {
        let end: i32 = line_end(reference.data, reference.len as i32, cursor)
        let line: string = copy_line(reference.data, cursor, end)
        let id: ParseI64 = str_parse_i64_at(line, 0)
        let kind: ParseI64 = str_parse_i64_at(line, id.end)
        let owner: ParseI64 = str_parse_i64_at(line, kind.end)
        let paired: ParseI64 = str_parse_i64_at(line, owner.end)
        let margin: ParseI64 = str_parse_i64_at(line, paired.end)
        let x: ParseF64 = str_parse_f64_at(line, margin.end)
        let y: ParseF64 = str_parse_f64_at(line, x.end)
        let z: ParseF64 = str_parse_f64_at(line, y.end)
        let radius: ParseF64 = str_parse_f64_at(line, z.end)
        let expression: ParseF64 = str_parse_f64_at(line, radius.end)
        let age: ParseF64 = str_parse_f64_at(line, expression.end)
        let old_radius: ParseF64 = str_parse_f64_at(line, age.end)
        if id.ok == false or kind.ok == false or owner.ok == false or paired.ok == false or margin.ok == false or x.ok == false or y.ok == false or z.ok == false or radius.ok == false or expression.ok == false or age.ok == false or old_radius.ok == false { return 10 }
        if id.value != node_id as i64 or kind.value != node[node_id].tipus as i64 or owner.value != node[node_id].icel as i64 or paired.value != node[node_id].altre as i64 or margin.value != node[node_id].marge as i64 { return 11 }
        if close_f64(node[node_id].x, x.value) == false or close_f64(node[node_id].y, y.value) == false or close_f64(node[node_id].z, z.value) == false or close_f64(node[node_id].grd, radius.value) == false or close_f64(gex[gene_expression_index(node_id, 1)], expression.value) == false or close_f64(agex[gene_expression_index(node_id, 1)], age.value) == false or close_f64(nodeo[node_id].grd, old_radius.value) == false { println(node_id, node[node_id].x, x.value, node[node_id].y, y.value, node[node_id].z, z.value, gex[gene_expression_index(node_id, 1)], expression.value, agex[gene_expression_index(node_id, 1)], age.value, nodeo[node_id].grd, old_radius.value); return 12 }
        cursor = line_next(reference.data, reference.len as i32, end)
        node_id = node_id + 1
    }
    let mut cell_id: i32 = 1
    while cell_id <= ncels {
        let end: i32 = line_end(reference.data, reference.len as i32, cursor)
        let line: string = copy_line(reference.data, cursor, end)
        let id: ParseI64 = str_parse_i64_at(line, 0)
        let count: ParseI64 = str_parse_i64_at(line, id.end)
        if id.ok == false or count.ok == false or id.value != cell_id as i64 or count.value != cels[cell_id].nunodes as i64 { return 13 }
        let mut position: i32 = count.end
        let mut slot: i32 = 1
        while slot <= cels[cell_id].nunodes {
            let member: ParseI64 = str_parse_i64_at(line, position)
            if member.ok == false or member.value != cels[cell_id].node[slot] as i64 { return 14 }
            position = member.end
            slot = slot + 1
        }
        cursor = line_next(reference.data, reference.len as i32, end)
        cell_id = cell_id + 1
    }
    if cursor < reference.len as i32 { return 15 }
    return 0
}

function check_growth_figure_six() -> i32 {
    if read_snapshot_parameters("../reference/examples/figure_6/gastrula.txt") != 0 { return 1 }
    inialea3d(nparti)
    calculate_extent()
    if force_growth_input() != 0 { return 3 }
    if should_i_grow() == false { return 4 + growth_error }
    if nd != 578 { return 20 }
    let mut node_id: i32 = 577
    while node_id <= nd {
        if fabs(node[node_id].x) > 10.0 or fabs(node[node_id].y) > 10.0 or fabs(node[node_id].z) > 10.0 { return 21 }
        node_id = node_id + 1
    }
    return 0
}

function main() -> i32 {
    let migration: i32 = check_growth_add("../reference/examples/migration/migration.txt", "fixtures/migration_growth_add.ref")
    if migration != 0 { return migration }
    let apoptosis: i32 = check_growth_add("../reference/examples/apoptosis/apoptosis.txt", "fixtures/apoptosis_growth_add.ref")
    if apoptosis != 0 { return apoptosis }
    let adhesion: i32 = check_growth_add("../reference/examples/differential_adhesion/differential_adhesion.txt", "fixtures/differential_adhesion_growth_add.ref")
    if adhesion != 0 { return adhesion }
    let polar_growth: i32 = check_growth_add("../reference/examples/polar_growth/polar_growth.txt", "fixtures/polar_growth_growth_add.ref")
    if polar_growth != 0 { return polar_growth }
    let apical: i32 = check_growth_add("../reference/examples/apical_contraction/apical_contraction.txt", "fixtures/apical_contraction_growth_add.ref")
    if apical != 0 { return apical }
    let ecm: i32 = check_growth_add("../reference/examples/ecm_secretion/ecm_secretion.txt", "fixtures/ecm_secretion_growth_add.ref")
    if ecm != 0 { return ecm }
    let figure_six: i32 = check_growth_figure_six()
    if figure_six != 0 { return figure_six }
    return check_growth_add("../reference/examples/sea_urchin_gastrulation/sea_urchin.txt", "fixtures/sea_urchin_growth_add.ref")
}
