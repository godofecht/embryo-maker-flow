import embryo.io { get_param_from_matrix_read }
import embryo.general { getot, temp, nparti, nd, ng, ncels, mnn, maxelong }

function main() -> i32 {
    let mut p: array<f64, 36> = [0.0, 11.0, 2.5, 400.0, 0.01, 0.25, 1.0, 1.5, -0.1, 3.0,
        120.0, 0.002, 5000.0, 2.25, 12.0, 0.05, 0.3, 0.01, 8.0, 4.0,
        0.0, 0.4, 300.0, 1.125, 0.1, 0.0005, 0.8, 0.7, 0.2, 0.01,
        0.000000000000002, 100.0, 200.0, 3.0, 0.9, 1.4]
    get_param_from_matrix_read(&p[0])
    if getot != 11 { return 1 }
    if temp != 2.5 { return 2 }
    if nparti != 400 { return 3 }
    if nd != 120 { return 4 }
    if ncels != 8 { return 5 }
    if ng != 4 { return 6 }
    if mnn != 300 { return 7 }
    if maxelong != 1.4 { return 8 }
    return 0
}
