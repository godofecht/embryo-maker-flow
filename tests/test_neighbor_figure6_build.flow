import embryo.io { read_snapshot_parameters }
import embryo.general { nd, ffu, nneigh, neigh, dneigh }
import embryo.neighboring { neighbor_build, neighbor_error, neighbor_index }

function main() -> i32 {
    if read_snapshot_parameters("../reference/examples/figure_6/gastrula.txt") != 0 { return 1 }
    if nd != 576 or ffu[2] != 1 or ffu[8] != 1 or ffu[9] != 1 { return 2 }
    if neighbor_build() == false { return 10 + neighbor_error }
    let mut node_id: i32 = 1
    while node_id <= nd {
        if nneigh[node_id] <= 0 { return 3 }
        let mut slot: i32 = 1
        while slot <= nneigh[node_id] {
            let index: i32 = neighbor_index(node_id, slot)
            let other: i32 = neigh[index]
            if other < 1 or other > nd or other == node_id or dneigh[index] <= 0.0 { return 4 }
            let mut earlier: i32 = 1
            while earlier < slot {
                if neigh[neighbor_index(node_id, earlier)] == other { return 5 }
                earlier = earlier + 1
            }
            slot = slot + 1
        }
        node_id = node_id + 1
    }
    return 0
}
