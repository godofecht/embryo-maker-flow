# Exhaustive undirected graphs on five vertices and directed graphs on four,
# in both row orders. Directed cases exercise asymmetric neighbor rows.
# A direct set-intersection implementation supplies the expected restoration.
import embryo.io { read_snapshot_parameters }
import embryo.general { nd, node, nneigh, neigh }
import embryo.neighboring { neighbor_build, neighbor_build_node, neighbor_remove_node, neighbor_validate_saved_prefixes, neighbor_index, fill_co_griders, restore_neighbors }

let mut expected: array<i32, 36> = []
let mut counts: array<i32, 6> = []

function has(row: i32, other: i32) -> bool {
    for slot in 1 to counts[row] + 1 {
        if expected[row * 6 + slot] == other { return true }
    }
    return false
}

function edge_bit(a: i32, b: i32, directed: i32, vertices: i32) -> i32 {
    let mut bit: i32 = 1
    for first in 1 to vertices + 1 {
        let begin: i32 = if directed == 0 { first + 1 } else { 1 }
        for second in begin to vertices + 1 {
            if first != second {
                if (a == first and b == second) or (directed == 0 and b == first and a == second) { return bit }
                bit = bit * 2
            }
        }
    }
    return 0
}

function main() -> i32 {
    if read_snapshot_parameters("../reference/examples/migration/migration.txt") != 0 { return 1 }
    if neighbor_build() == false { return 2 }
    for directed in 0 to 2 {
        let vertices: i32 = if directed == 0 { 5 } else { 4 }
        let masks: i32 = if directed == 0 { 1024 } else { 4096 }
        nd = vertices
        for i in 1 to vertices + 1 { node[i].tipus = 1 }
        for reverse in 0 to 2 {
            for mask in 0 to masks {
                # Save the complete graph in the same order as fill_co_griders.
                for first in 1 to vertices + 1 {
                    nneigh[first] = 0
                    for second in 1 to vertices + 1 {
                        if second != first {
                            nneigh[first] = nneigh[first] + 1
                            neigh[neighbor_index(first, nneigh[first])] = second
                        }
                    }
                }
                if fill_co_griders() == false { return 3 }
                for first in 1 to vertices + 1 {
                    counts[first] = 0
                    for ordinal in 1 to vertices + 1 {
                        let second: i32 = if reverse == 0 { ordinal } else { vertices + 1 - ordinal }
                        if first != second and (mask / edge_bit(first, second, directed, vertices)) % 2 == 1 {
                            counts[first] = counts[first] + 1
                            expected[first * 6 + counts[first]] = second
                            neigh[neighbor_index(first, counts[first])] = second
                        }
                    }
                    nneigh[first] = counts[first]
                }
                for first in 1 to vertices + 1 {
                    for second in first + 1 to vertices + 1 {
                        if not has(first, second) {
                            let mut recover: bool = true
                            for shared in 1 to vertices + 1 {
                                if has(first, shared) and has(second, shared) {
                                    for linked in 1 to vertices + 1 {
                                        if has(shared, linked) and has(first, linked) and has(second, linked) { recover = false }
                                    }
                                }
                            }
                            if recover {
                                counts[first] = counts[first] + 1
                                expected[first * 6 + counts[first]] = second
                                counts[second] = counts[second] + 1
                                expected[second * 6 + counts[second]] = first
                            }
                        }
                    }
                }
                if restore_neighbors() == false { return 4 }
                if not neighbor_validate_saved_prefixes() { return 7 }
                for first in 1 to vertices + 1 {
                    if nneigh[first] != counts[first] { println("count mismatch", mask, reverse, first); return 5 }
                    for slot in 1 to counts[first] + 1 {
                        if neigh[neighbor_index(first, slot)] != expected[first * 6 + slot] { println("order mismatch", mask, reverse, first, slot); return 6 }
                    }
                }
            }
        }
    }
    # Exercise repeated unchanged rows and moved rows through local rebuilds.
    if read_snapshot_parameters("../reference/examples/sea_urchin_gastrulation/sea_urchin.txt") != 0 { return 8 }
    if not neighbor_build() or not fill_co_griders() { return 9 }
    for pass in 0 to 4 {
        for first in 1 to 65 {
            let original_x: f64 = node[first].x
            if pass % 2 == 1 { node[first].x = original_x + 0.05 }
            if not neighbor_build_node(first) or not restore_neighbors() { return 10 }
            if not neighbor_validate_saved_prefixes() { return 11 }
            node[first].x = original_x
            if not neighbor_build_node(first) or not restore_neighbors() { return 12 }
            if not neighbor_validate_saved_prefixes() { return 13 }
        }
    }
    for pass in 0 to 3 {
        let deleted: i32 = if pass == 0 { 1 } else { if pass == 1 { nd / 2 } else { nd } }
        neighbor_remove_node(deleted)
        nd = nd - 1
        if not neighbor_validate_saved_prefixes() { return 14 }
    }
    println("PASS: 10240 restoration graphs, 512 local rebuilds, three deletions")
    return 0
}
