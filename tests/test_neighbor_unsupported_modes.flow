import embryo.io { read_snapshot_parameters }
import embryo.general { ffu }
import embryo.neighboring { neighbor_build, neighbor_error }

function main() -> i32 {
    if read_snapshot_parameters("../reference/examples/apical_contraction/apical_contraction.txt") != 0 { return 1 }
    ffu[8] = 0
    ffu[9] = 0
    ffu[2] = 1
    if neighbor_build() != false { return 2 }
    if neighbor_error != 10 { return 3 }
    return 0
}
