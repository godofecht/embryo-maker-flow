import embryo.io { read_snapshot_parameters }
import embryo.general { ncels, nparti, cels }
import embryo.aleas { inialea3d }
import embryo.polarization { polarization }
import embryo.genetic { npag }
import std.io { FileRead, io_read_file }
import std.string { ParseI64, ParseF64, str_parse_i64_at, str_parse_f64_at }

extern {
    function malloc(size: i64) -> ptr<void>
    function fabs(x: f64) -> f64
    function sqrt(x: f64) -> f64
}

function line_end(data: string, length: i32, start: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = start
    while cursor < length and bytes[cursor] != 10 and bytes[cursor] != 13 { cursor = cursor + 1 }
    return cursor
}

function line_next(data: string, length: i32, end: i32) -> i32 {
    let bytes: ptr<u8> = data as ptr<u8>
    let mut cursor: i32 = end
    if cursor < length and bytes[cursor] == 13 { cursor = cursor + 1 }
    if cursor < length and bytes[cursor] == 10 { cursor = cursor + 1 }
    return cursor
}

function copy_line(data: string, start: i32, end: i32) -> string {
    let bytes: ptr<u8> = data as ptr<u8>
    let line: ptr<u8> = malloc((end - start + 1) as i64) as ptr<u8>
    let mut source: i32 = start
    let mut target: i32 = 0
    while source < end { line[target] = bytes[source]; source = source + 1; target = target + 1 }
    line[target] = 0
    return line as string
}

function check_polarization(input_path: string, fixture_path: string) -> i32 {
    if read_snapshot_parameters(input_path) != 0 { return 1 }
    inialea3d(nparti)
    if npag[43] > 0 and polarization() == false { return 3 }
    let reference: FileRead = io_read_file(fixture_path)
    if reference.ok == false { return 4 }
    let mut cursor: i32 = 0
    let mut cell_id: i32 = 1
    while cell_id <= ncels {
        let end: i32 = line_end(reference.data, reference.len as i32, cursor)
        let line: string = copy_line(reference.data, cursor, end)
        let id: ParseI64 = str_parse_i64_at(line, 0)
        let x: ParseF64 = str_parse_f64_at(line, id.end)
        let y: ParseF64 = str_parse_f64_at(line, x.end)
        let z: ParseF64 = str_parse_f64_at(line, y.end)
        if id.ok == false or x.ok == false or y.ok == false or z.ok == false or id.value != cell_id as i64 { return 5 }
        let mut component: i32 = 0
        while component < 3 {
            let mut expected: f64 = x.value
            let mut actual: f64 = cels[cell_id].polx
            if component == 1 { expected = y.value; actual = cels[cell_id].poly }
            if component == 2 { expected = z.value; actual = cels[cell_id].polz }
            let scale: f64 = if fabs(expected) > 1.0 { fabs(expected) } else { 1.0 }
            if fabs(actual - expected) > 1.0e-9 * scale { return 10 }
            component = component + 1
        }
        cursor = line_next(reference.data, reference.len as i32, end)
        cell_id = cell_id + 1
    }
    return 0
}

function check_polar_growth_polarity() -> i32 {
    if read_snapshot_parameters("../reference/examples/polar_growth/polar_growth.txt") != 0 { return 1 }
    inialea3d(nparti)
    if npag[43] > 0 and polarization() == false { return 3 }
    let mut cell_id: i32 = 1
    while cell_id <= ncels {
        let x: f64 = cels[cell_id].polx
        let y: f64 = cels[cell_id].poly
        let z: f64 = cels[cell_id].polz
        let length: f64 = sqrt((x * x) + (y * y) + (z * z))
        if length > 1.0e-12 and fabs(length - 1.0) > 1.0e-9 { return 11 }
        if fabs(x) > 1.0 or fabs(y) > 1.0 or fabs(z) > 1.0 { return 12 }
        cell_id = cell_id + 1
    }
    return 0
}

function main() -> i32 {
    let migration: i32 = check_polarization("../reference/examples/migration/migration.txt", "fixtures/migration_polarization.ref")
    if migration != 0 { return migration }
    let apoptosis: i32 = check_polarization("../reference/examples/apoptosis/apoptosis.txt", "fixtures/apoptosis_polarization.ref")
    if apoptosis != 0 { return apoptosis }
    let adhesion: i32 = check_polarization("../reference/examples/differential_adhesion/differential_adhesion.txt", "fixtures/differential_adhesion_polarization.ref")
    if adhesion != 0 { return adhesion }
    let polar_growth: i32 = check_polar_growth_polarity()
    if polar_growth != 0 { return polar_growth }
    let apical: i32 = check_polarization("../reference/examples/apical_contraction/apical_contraction.txt", "fixtures/apical_contraction_polarization.ref")
    if apical != 0 { return apical }
    let ecm: i32 = check_polarization("../reference/examples/ecm_secretion/ecm_secretion.txt", "fixtures/ecm_secretion_polarization.ref")
    if ecm != 0 { return ecm }
    let figure_six: i32 = check_polarization("../reference/examples/figure_6/gastrula.txt", "fixtures/figure_6_polarization.ref")
    if figure_six != 0 { return figure_six }
    return check_polarization("../reference/examples/sea_urchin_gastrulation/sea_urchin.txt", "fixtures/sea_urchin_polarization.ref")
}
