import embryo.io { read_snapshot_parameters }
import embryo.aleas { inialea3d }
import embryo.general { nparti, nd, node, getot, rtime }
import embryo.model { advance_model_batch, model_batch_begin, model_batch_advance_chunk, ModelBatchProgress, model_error }

function position_checksum() -> f64 {
    let mut checksum: f64 = 0.0
    let mut i: i32 = 1
    while i <= nd {
        checksum = checksum + (i as f64) * (node[i].x + node[i].y * 3.0 + node[i].z * 7.0)
        i = i + 1
    }
    return checksum
}

function check_batch(path: string, expected_iterations: i32) -> i32 {
    if read_snapshot_parameters(path) != 0 { return 1 }
    inialea3d(nparti)
    if advance_model_batch(1) == false { println("batch failed", path, model_error); return 2 }
    if getot != expected_iterations { println("OG simulated-time iteration count mismatch", path, getot, expected_iterations); return 3 }
    if rtime < 1.0 or rtime > 1.02 { println("OG simulated-time endpoint mismatch", path, rtime); return 4 }
    let expected_checksum: f64 = position_checksum()
    if read_snapshot_parameters(path) != 0 { return 5 }
    inialea3d(nparti)
    if model_batch_begin(1, 1) == false { println("chunked batch did not start", path, model_error); return 6 }
    let mut complete: bool = false
    while complete == false {
        let progress: ModelBatchProgress = model_batch_advance_chunk(1, 7)
        if progress.ok == false { println("chunked batch failed", path, model_error); return 7 }
        complete = progress.complete
    }
    if getot != expected_iterations { println("chunked OG iteration count mismatch", path, getot, expected_iterations); return 8 }
    let actual_checksum: f64 = position_checksum()
    if actual_checksum != expected_checksum { println("chunked batch state mismatch", path, actual_checksum, expected_checksum); return 9 }
    return 0
}

function main() -> i32 {
    if check_batch("../reference/examples/migration/migration.txt", 181) != 0 { return 10 }
    if check_batch("../reference/examples/apoptosis/apoptosis.txt", 414) != 0 { return 20 }
    if check_batch("../reference/examples/differential_adhesion/differential_adhesion.txt", 1215) != 0 { return 30 }
    if check_batch("../reference/examples/polar_growth/polar_growth.txt", 109) != 0 { return 40 }
    if check_batch("../reference/examples/ecm_secretion/ecm_secretion.txt", 388) != 0 { return 50 }
    if check_batch("../reference/examples/figure_6/gastrula.txt", 2) != 0 { return 60 }
    return 0
}
