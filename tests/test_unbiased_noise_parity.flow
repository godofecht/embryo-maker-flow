import embryo.io { read_snapshot_parameters }
import embryo.general { nd, node, ffu, delta, nparti }
import embryo.aleas { inialea3d }
import embryo.model { itera_unbiased }
import std.io { FileRead, io_read_file }
import std.string { ParseI64, ParseF64, str_parse_i64_at, str_parse_f64_at }

extern {
    function fabs(x: f64) -> f64
    function malloc(size: i64) -> ptr<void>
}

function check(path: string, fixture: string) -> i32 {
    if read_snapshot_parameters(path) != 0 { return 1 }
    inialea3d(nparti)
    ffu[15] = 0
    ffu[16] = 0
    delta = 0.001
    if itera_unbiased() == false { return 2 }
    let expected: FileRead = io_read_file(fixture)
    if expected.ok == false { return 3 }
    let bytes: ptr<u8> = expected.data as ptr<u8>
    let mut cursor: i32 = 0
    let expected_count: ParseI64 = str_parse_i64_at(expected.data, cursor)
    if expected_count.ok == false or expected_count.value != nd as i64 { return 4 }
    while cursor < expected.len as i32 and bytes[cursor] != 10 and bytes[cursor] != 13 { cursor = cursor + 1 }
    while cursor < expected.len as i32 and (bytes[cursor] == 10 or bytes[cursor] == 13) { cursor = cursor + 1 }
    let mut current: i32 = 1
    while current <= nd {
        let line: ptr<u8> = malloc((expected.len + 1) as i64) as ptr<u8>
        let mut length: i32 = 0
        while cursor < expected.len as i32 and bytes[cursor] != 10 and bytes[cursor] != 13 {
            line[length] = bytes[cursor]
            cursor = cursor + 1
            length = length + 1
        }
        while cursor < expected.len as i32 and (bytes[cursor] == 10 or bytes[cursor] == 13) { cursor = cursor + 1 }
        line[length] = 0
        let id: ParseI64 = str_parse_i64_at(line as string, 0)
        let x: ParseF64 = str_parse_f64_at(line as string, id.end)
        let y: ParseF64 = str_parse_f64_at(line as string, x.end)
        let z: ParseF64 = str_parse_f64_at(line as string, y.end)
        if id.ok == false or x.ok == false or y.ok == false or z.ok == false or id.value != current as i64 { return 5 }
        if fabs(node[current].x - x.value) > 1.0e-12 or fabs(node[current].y - y.value) > 1.0e-12 or fabs(node[current].z - z.value) > 1.0e-12 { return 6 }
        current = current + 1
    }
    return 0
}

function main() -> i32 {
    if check("../reference/examples/migration/migration.txt", "fixtures/migration_unbiased_noise.ref") != 0 { return 1 }
    if check("../reference/examples/apoptosis/apoptosis.txt", "fixtures/apoptosis_unbiased_noise.ref") != 0 { return 2 }
    return check("../reference/examples/differential_adhesion/differential_adhesion.txt", "fixtures/differential_adhesion_unbiased_noise.ref")
}
