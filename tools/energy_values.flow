import embryo.io { read_snapshot_parameters }
import embryo.general { nd, node, nparti }
import embryo.aleas { inialea3d }
import embryo.neighboring { neighbor_build }
import embryo.energy { energia, energy_error }
import std.process { proc_argc, proc_argv }

extern { function printf(format: string, ...) -> i32 }

function main() -> i32 {
    if proc_argc() < 2 { return 1 }
    if read_snapshot_parameters(proc_argv(1)) != 0 { return 2 }
    inialea3d(nparti)
    if neighbor_build() == false { return 3 }
    let mut node_id: i32 = 1
    while node_id <= nd {
        if energia(node_id) == false { return 4 + energy_error }
        printf("%d %.17g\n", node_id, node[node_id].e)
        node_id = node_id + 1
    }
    return 0
}
