import embryo.io { read_snapshot_parameters }
import embryo.general { nd, ncels, cels, node, dmax, rdiffmax, deltamin, delta, ffu, nparti }
import embryo.aleas { inialea3d }
import embryo.neighboring { neighbor_build, restore_neighbors }
import embryo.genetic { ng, gex, agex, gene_stuff }
import embryo.nexus { nexe_gradual }
import embryo.biomechanic { rungekutta4, adaptive_rungekutta }
import embryo.model { prepare_model_iteration, commit_gene_expression }
import embryo.noise { itera_energy }
import embryo.rng { rng_get }
import std.process { proc_argc, proc_argv }

extern { function printf(format: string, ...) -> i32 }

function main() -> i32 {
    if proc_argc() < 2 { return 1 }
    if read_snapshot_parameters(proc_argv(1)) != 0 { return 2 }
    inialea3d(nparti)
    if prepare_model_iteration() == false { return 3 }
    if neighbor_build() == false { return 4 }
    if ffu[24] == 0 and restore_neighbors() == false { return 5 }
    delta = deltamin
    if gene_stuff() == false { return 6 }
    if nexe_gradual() == false { return 7 }
    if ffu[12] == 0 {
        if rungekutta4(delta) == false { return 8 }
    } elif adaptive_rungekutta() == false { return 8 }
    commit_gene_expression()
    let mut attempt: i32 = 0
    while attempt < nd {
        if itera_energy() == false { return 9 }
        attempt = attempt + 1
    }
    let mut seeds: array<i32, 8> = [0, 0, 0, 0, 0, 0, 0, 0]
    rng_get(&seeds[0], 8)
    let mut i: i32 = 0
    while i < 8 { printf("%d ", seeds[i]); i = i + 1 }
    printf("\n")
    i = 1
    while i <= nd {
        printf("%d %.17g %.17g %.17g %.17g\n", i, node[i].x, node[i].y, node[i].z, node[i].e)
        i = i + 1
    }
    return 0
}
