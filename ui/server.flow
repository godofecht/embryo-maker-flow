extern {
    function flow_rt_tcp_listen(port: i32) -> i32
    function flow_rt_tcp_accept(listen_fd: i32) -> i32
    function flow_rt_tcp_close(fd: i32) -> i32
    function flow_rt_tcp_recv(fd: i32, buf: ptr<void>, len: i32) -> i32
    function flow_rt_tcp_send(fd: i32, buf: ptr<void>, len: i32) -> i32
    function unlink(path: string) -> i32
    function mkdir(path: string, mode: i32) -> i32
    function strlen(s: string) -> i64
    function malloc(size: i64) -> ptr<void>
    function realloc(p: ptr<void>, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

@cEmbed("#include <arpa/inet.h>
#include <netinet/in.h>
#include <sys/socket.h>
#include <sys/time.h>
#include <stdint.h>
#include <signal.h>
extern int close(int);
static void embryomaker_ignore_sigpipe(void) { signal(SIGPIPE, SIG_IGN); }
static int32_t embryomaker_loopback_listen(int32_t port) { int fd = socket(AF_INET, SOCK_STREAM, 0); if (fd < 0) return -1; int yes = 1; setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes)); struct sockaddr_in addr = {0}; addr.sin_family = AF_INET; addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK); addr.sin_port = htons((uint16_t)port); if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0 || listen(fd, 64) < 0) { close(fd); return -1; } return fd; }
static int32_t embryomaker_configure_client(int fd) { struct timeval send_timeout = {10, 0}; struct timeval recv_timeout = {30, 0}; int yes = 1; if (setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &send_timeout, sizeof(send_timeout)) < 0) return -1; if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &recv_timeout, sizeof(recv_timeout)) < 0) return -1;
#ifdef SO_NOSIGPIPE
if (setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &yes, sizeof(yes)) < 0) return -1;
#endif
return 0; }
")
extern { function embryomaker_loopback_listen(port: i32) -> i32 }
extern { function embryomaker_configure_client(fd: i32) -> i32 }
extern { function embryomaker_ignore_sigpipe() -> void }

const MAX_REQUEST: i32 = 16777216
const SESSION_ID: string = "00000000000000000000000000000001"
const EXAMPLE_COUNT: i32 = 23

let mut session_active: bool = false
let mut session_name: string = ""
let mut session_name_owned: ptr<u8> = null
let mut snapshot_file: string = ""
let mut rollback_file: string = ""
let mut upload_counter: i32 = 0

struct HttpRequest {
    bytes: ptr<u8>,
    length: i32,
    method_start: i32,
    method_end: i32,
    path_start: i32,
    path_end: i32,
    body_start: i32,
    body_length: i32,
    valid: bool
}

