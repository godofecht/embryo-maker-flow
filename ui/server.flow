function write_json_string(out: ptr<ByteBuf>, value: string) -> void {
    let bytes: ptr<u8> = value as ptr<u8>
    let length: i32 = strlen(value) as i32
    bb_putc(out, 34)
    let mut i: i32 = 0
    while i < length {
        let c: i32 = bytes[i] as i32
        if c == 34 { bb_puts(out, "\\\"") }
        elif c == 92 { bb_puts(out, "\\\\") }
        elif c == 10 { bb_puts(out, "\\n") }
        elif c == 13 { bb_puts(out, "\\r") }
        elif c == 9 { bb_puts(out, "\\t") }
        elif c < 32 { bb_putc(out, 32) }
        else { bb_putc(out, c as u8) }
        i = i + 1
    }
    bb_putc(out, 34)
}

function make_examples_json() -> string {
    let out: ptr<ByteBuf> = bb_new(512)
    bb_puts(out, "{\"examples\":[")
    let mut i: i32 = 0
    while i < EXAMPLE_COUNT {
        if i > 0 { bb_putc(out, 44) }
        bb_puts(out, "{\"id\":")
        write_json_string(out, example_id(i))
        bb_puts(out, ",\"name\":")
        write_json_string(out, example_name(i))
        bb_putc(out, 125)
        i = i + 1
    }
    bb_puts(out, "]}")
    let result: string = bb_str(out)
    bb_free(out)
    return result
}

function bytes_equal(bytes: ptr<u8>, start: i32, end: i32, value: string) -> bool {
    let wanted: ptr<u8> = value as ptr<u8>
    let wanted_len: i32 = strlen(value) as i32
    if end - start != wanted_len { return false }
    let mut i: i32 = 0
    while i < wanted_len {
        if bytes[start + i] != wanted[i] { return false }
        i = i + 1
    }
    return true
}

function find_bytes(bytes: ptr<u8>, length: i32, from: i32, value: string) -> i32 {
    let needle: ptr<u8> = value as ptr<u8>
    let needle_len: i32 = strlen(value) as i32
    let mut i: i32 = from
    while i + needle_len <= length {
        let mut j: i32 = 0
        let mut found: bool = true
        while j < needle_len {
            if bytes[i + j] != needle[j] { found = false; break }
            j = j + 1
        }
        if found { return i }
        i = i + 1
    }
    return -1
}

function header_name_matches(bytes: ptr<u8>, start: i32, end: i32, wanted: string) -> bool {
    let wanted_bytes: ptr<u8> = wanted as ptr<u8>
    let wanted_length: i32 = strlen(wanted) as i32
    if end - start != wanted_length { return false }
    let mut i: i32 = 0
    while i < wanted_length {
        let mut value: i32 = bytes[start + i] as i32
        if value >= 65 and value <= 90 { value = value + 32 }
        if value != wanted_bytes[i] as i32 { return false }
        i = i + 1
    }
    return true
}

function parse_content_length(bytes: ptr<u8>, header_end: i32) -> i32 {
    let mut line_start: i32 = 0
    let mut found: bool = false
    let mut content_length: i32 = 0
    while line_start < header_end {
        let line_break: i32 = find_bytes(bytes, header_end, line_start, "\r\n")
        let line_end: i32 = if line_break < 0 { header_end } else { line_break }
        let mut colon: i32 = line_start
        while colon < line_end and bytes[colon] != 58 { colon = colon + 1 }
        if colon < line_end {
            if header_name_matches(bytes, line_start, colon, "transfer-encoding") { return -1 }
            if header_name_matches(bytes, line_start, colon, "content-length") {
                if found { return -1 }
                let mut p: i32 = colon + 1
                while p < line_end and (bytes[p] == 32 or bytes[p] == 9) { p = p + 1 }
                if p >= line_end { return -1 }
                let mut parsed_length: i32 = 0
                let mut digits: i32 = 0
                while p < line_end and bytes[p] >= 48 and bytes[p] <= 57 {
                    let digit: i32 = bytes[p] as i32 - 48
                    if parsed_length > (8000000 - digit) / 10 { return -1 }
                    parsed_length = parsed_length * 10 + digit
                    digits = digits + 1
                    p = p + 1
                }
                if digits == 0 { return -1 }
                while p < line_end and (bytes[p] == 32 or bytes[p] == 9) { p = p + 1 }
                if p != line_end { return -1 }
                content_length = parsed_length
                found = true
            }
        }
        if line_break < 0 { break }
        line_start = line_end + 2
    }
    return content_length
}

function read_request(fd: i32) -> HttpRequest {
    let mut capacity: i32 = 4096
    let mut storage: ptr<u8> = malloc((capacity + 1) as i64) as ptr<u8>
    if storage == null { return HttpRequest { bytes: null, length: 0, method_start: 0, method_end: 0, path_start: 0, path_end: 0, body_start: 0, body_length: 0, valid: false } }
    let mut length: i32 = 0
    let mut header_end: i32 = -1
    let mut required: i32 = -1
    let mut failed: bool = false
    while length < MAX_REQUEST {
        if length >= capacity {
            let next_capacity: i32 = if capacity > (MAX_REQUEST / 2) { MAX_REQUEST } else { capacity * 2 }
            let grown: ptr<u8> = realloc(storage as ptr<void>, (next_capacity + 1) as i64) as ptr<u8>
            if grown == null { failed = true; break }
            storage = grown
            capacity = next_capacity
        }
        let remaining: i32 = MAX_REQUEST - length
        let available: i32 = capacity - length
        let read_size: i32 = if available > 16384 { 16384 } else { available }
        let chunk: i32 = if read_size > remaining { remaining } else { read_size }
        let got: i32 = flow_rt_tcp_recv(fd, &storage[length] as ptr<void>, chunk)
        if got <= 0 { failed = true; break }
        length = length + got
        storage[length] = 0
        if header_end < 0 {
            header_end = find_bytes(storage, length, 0, "\r\n\r\n")
            if header_end >= 0 {
                let body_len: i32 = parse_content_length(storage, header_end)
                if body_len < 0 or body_len > 8000000 { failed = true; break }
                required = header_end + 4 + body_len
                if required > MAX_REQUEST { failed = true; break }
            }
        }
        if required >= 0 and length >= required { break }
    }
    if failed or header_end < 0 or required < 0 or length < required {
        free(storage as ptr<void>)
        return HttpRequest { bytes: null, length: 0, method_start: 0, method_end: 0, path_start: 0, path_end: 0, body_start: 0, body_length: 0, valid: false }
    }
    let mut method_end: i32 = 0
    while method_end < header_end and storage[method_end] != 32 { method_end = method_end + 1 }
    let path_start: i32 = method_end + 1
    let mut path_end: i32 = path_start
    while path_end < header_end and storage[path_end] != 32 and storage[path_end] != 63 { path_end = path_end + 1 }
    return HttpRequest { bytes: storage, length: length, method_start: 0, method_end: method_end, path_start: path_start, path_end: path_end, body_start: header_end + 4, body_length: required - header_end - 4, valid: true }
}

function json_key_value(body: ptr<u8>, length: i32, key: string) -> i32 {
    let wanted: ptr<u8> = key as ptr<u8>
    let key_length: i32 = strlen(key) as i32
    let mut start: i32 = 0
    while start + key_length + 1 < length {
        if body[start] == 34 {
            let mut offset: i32 = 0
            while offset < key_length and body[start + 1 + offset] == wanted[offset] { offset = offset + 1 }
            if offset == key_length and body[start + key_length + 1] == 34 {
                let mut p: i32 = start + key_length + 2
                while p < length and (body[p] == 32 or body[p] == 9 or body[p] == 10 or body[p] == 13) { p = p + 1 }
                if p < length and body[p] == 58 {
                    p = p + 1
                    while p < length and (body[p] == 32 or body[p] == 9 or body[p] == 10 or body[p] == 13) { p = p + 1 }
                    return p
                }
            }
        }
        start = start + 1
    }
    return -1
}

function session_path_is(bytes: ptr<u8>, start: i32, end: i32, suffix: string) -> bool {
    let prefix: string = "/api/session/"
    let prefix_length: i32 = strlen(prefix) as i32
    let id_length: i32 = strlen(SESSION_ID) as i32
    let suffix_length: i32 = strlen(suffix) as i32
    if end - start != prefix_length + id_length + suffix_length { return false }
    if bytes_equal(bytes, start, start + prefix_length, prefix) == false { return false }
    if bytes_equal(bytes, start + prefix_length, start + prefix_length + id_length, SESSION_ID) == false { return false }
    return bytes_equal(bytes, start + prefix_length + id_length, end, suffix)
}

function hex_digit(c: i32) -> i32 {
    if c >= 48 and c <= 57 { return c - 48 }
    if c >= 65 and c <= 70 { return c - 55 }
    if c >= 97 and c <= 102 { return c - 87 }
    return -1
}

function decode_json_string(body: ptr<u8>, length: i32, key: string, output: ptr<u8>, capacity: i32) -> i32 {
    let p: i32 = json_key_value(body, length, key)
    if p < 0 or p >= length or body[p] != 34 { return -1 }
    p = p + 1
    let mut out: i32 = 0
    while p < length and body[p] != 34 {
        let mut c: i32 = body[p] as i32
        p = p + 1
        if c == 92 {
            if p >= length { return -1 }
            c = body[p] as i32
            p = p + 1
            if c == 110 { c = 10 }
            elif c == 114 { c = 13 }
            elif c == 116 { c = 9 }
            elif c == 98 { c = 8 }
            elif c == 102 { c = 12 }
            elif c == 117 {
                if p + 4 > length { return -1 }
                let mut code: i32 = 0
                let mut d: i32 = 0
                while d < 4 {
                    let h: i32 = body[p + d] as i32
                    let digit: i32 = hex_digit(h)
                    if digit < 0 { return -1 }
                    code = code * 16 + digit
                    d = d + 1
                }
                p = p + 4
                if code < 128 { c = code }
                elif code < 2048 {
                    if out + 2 >= capacity { return -1 }
                    output[out] = (192 + code / 64) as u8
                    out = out + 1
                    c = 128 + (code % 64)
                } else {
                    if out + 3 >= capacity { return -1 }
                    output[out] = (224 + code / 4096) as u8
                    output[out + 1] = (128 + ((code / 64) % 64)) as u8
                    out = out + 2
                    c = 128 + (code % 64)
                }
            }
        }
        if out + 1 >= capacity { return -1 }
        output[out] = c as u8
        out = out + 1
    }
    if p >= length { return -1 }
    output[out] = 0
    return out
}

function json_integer(body: ptr<u8>, length: i32, key: string, fallback: i32) -> i32 {
    let mut p: i32 = json_key_value(body, length, key)
    if p < 0 { return fallback }
    let mut sign: i32 = 1
    if p < length and body[p] == 45 { sign = -1; p = p + 1 }
    let mut value: i32 = 0
    let mut digits: i32 = 0
    while p < length and body[p] >= 48 and body[p] <= 57 {
        value = value * 10 + (body[p] as i32 - 48)
        digits = digits + 1
        p = p + 1
    }
    if digits == 0 { return fallback }
    return value * sign
}

function apply_node_property(node_id: i32, field: string, value: f64) -> bool {
    if field == "x" { node[node_id].x = value }
    elif field == "y" { node[node_id].y = value }
    elif field == "z" { node[node_id].z = value }
    elif field == "energy" { node[node_id].e = value }
    elif field == "eqd" { node[node_id].eqd = value }
    elif field == "radius" { node[node_id].add = value }
    elif field == "you" { node[node_id].you = value }
    elif field == "adh" { node[node_id].adh = value }
    elif field == "rep" { node[node_id].rep = value }
    elif field == "rec" { node[node_id].rec = value }
    elif field == "erp" { node[node_id].erp = value }
    elif field == "est" { node[node_id].est = value }
    elif field == "eqs" { node[node_id].eqs = value }
    elif field == "hoo" { node[node_id].hoo = value }
    elif field == "mov" { node[node_id].mov = value }
    elif field == "dmo" { node[node_id].dmo = value }
    elif field == "x0" { node[node_id].orix = value }
    elif field == "y0" { node[node_id].oriy = value }
    elif field == "z0" { node[node_id].oriz = value }
    elif field == "ecm" { node[node_id].ecm = value }
    elif field == "cod" { node[node_id].cod = value }
    elif field == "grd" { node[node_id].grd = value }
    elif field == "pld" { node[node_id].pld = value }
    elif field == "vod" { node[node_id].vod = value }
    elif field == "dif" { node[node_id].dif = value }
    elif field == "kfi" { node[node_id].kfi = value }
    elif field == "pla" { node[node_id].pla = value }
    elif field == "kvol" { node[node_id].kvol = value }
    elif field == "type" { node[node_id].tipus = value as i32 }
    elif field == "cell" { node[node_id].icel = value as i32 }
    elif field == "other" { node[node_id].altre = value as i32 }
    elif field == "marge" { node[node_id].marge = value as i32 }
    elif field == "talone" { node[node_id].talone = value as i32 }
    elif field == "fixed" { node[node_id].fix = value as i32 }
    elif field == "ndiv" { node[node_id].ndiv = value as i32 }
    else { return false }
    return true
}

function apply_cell_property(cell_id: i32, field: string, value: f64) -> bool {
    if field == "phase" { cels[cell_id].fase = value }
    elif field == "time" { cels[cell_id].temt = value }
    elif field == "x" { cels[cell_id].cex = value }
    elif field == "y" { cels[cell_id].cey = value }
    elif field == "z" { cels[cell_id].cez = value }
    elif field == "polx" { cels[cell_id].polx = value }
    elif field == "poly" { cels[cell_id].poly = value }
    elif field == "polz" { cels[cell_id].polz = value }
    elif field == "minsize_for_div" { cels[cell_id].minsize_for_div = value }
    elif field == "maxsize_for_div" { cels[cell_id].maxsize_for_div = value }
    elif field == "nodela" { cels[cell_id].nodela = value as i32 }
    elif field == "type" { cels[cell_id].ctipus = value as i32 }
    else { return false }
    return true
}

function handle_node_edit(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let node_id: i32 = json_integer(body, body_len, "nodeId", 0)
    if node_id < 1 or node_id > nd { send_response(fd, 400, "application/json", make_error("Node index is outside the active model")); return }
    let field_buffer: ptr<u8> = malloc(64) as ptr<u8>
    if field_buffer == null { send_response(fd, 500, "application/json", make_error("Out of memory")); return }
    let field_length: i32 = decode_json_string(body, body_len, "field", field_buffer, 64)
    let value_pos: i32 = json_key_value(body, body_len, "value")
    if field_length < 0 or value_pos < 0 { free(field_buffer as ptr<void>); send_response(fd, 400, "application/json", make_error("Node edit requires a field and numeric value")); return }
    let parsed: ParseF64 = str_parse_f64_at(body as string, value_pos)
    if parsed.ok == false { free(field_buffer as ptr<void>); send_response(fd, 400, "application/json", make_error("Node edit value is invalid")); return }
    let field: string = field_buffer as string
    let changes_geometry: bool = field == "x" or field == "y" or field == "z"
    let original: Nod = node[node_id]
    if apply_node_property(node_id, field, parsed.value) == false { free(field_buffer as ptr<void>); send_response(fd, 400, "application/json", make_error("Unsupported node property")); return }
    if changes_geometry and neighbor_build() == false {
        node[node_id] = original
        let _restore: bool = neighbor_build()
        free(field_buffer as ptr<void>)
        send_response(fd, 422, "application/json", make_error("Edited node position breaks the current neighbor graph"))
        return
    }
    free(field_buffer as ptr<void>)
    send_model_response(fd, getot, false, true)
}

function handle_node_move(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let node_id: i32 = json_integer(body, body_len, "nodeId", 0)
    if node_id < 1 or node_id > nd { send_response(fd, 400, "application/json", make_error("Node index is outside the active model")); return }
    let x_pos: i32 = json_key_value(body, body_len, "x")
    let y_pos: i32 = json_key_value(body, body_len, "y")
    let z_pos: i32 = json_key_value(body, body_len, "z")
    if x_pos < 0 or y_pos < 0 or z_pos < 0 { send_response(fd, 400, "application/json", make_error("Node move requires x, y, and z coordinates")); return }
    let x_value: ParseF64 = str_parse_f64_at(body as string, x_pos)
    let y_value: ParseF64 = str_parse_f64_at(body as string, y_pos)
    let z_value: ParseF64 = str_parse_f64_at(body as string, z_pos)
    if x_value.ok == false or y_value.ok == false or z_value.ok == false { send_response(fd, 400, "application/json", make_error("Node move coordinates must be numeric")); return }
    let original: Nod = node[node_id]
    node[node_id].x = x_value.value
    node[node_id].y = y_value.value
    node[node_id].z = z_value.value
    if neighbor_build() == false {
        node[node_id] = original
        let _restore: bool = neighbor_build()
        send_response(fd, 422, "application/json", make_error("Moved node breaks the current neighbor graph")); return
    }
    send_model_response(fd, getot, false, true)
}

function handle_cell_move(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let cell_id: i32 = json_integer(body, body_len, "cellId", 0)
    if cell_id < 1 or cell_id > ncels { send_response(fd, 400, "application/json", make_error("Cell index is outside the active model")); return }
    let x_pos: i32 = json_key_value(body, body_len, "x")
    let y_pos: i32 = json_key_value(body, body_len, "y")
    let z_pos: i32 = json_key_value(body, body_len, "z")
    if x_pos < 0 or y_pos < 0 or z_pos < 0 { send_response(fd, 400, "application/json", make_error("Cell move requires x, y, and z coordinates")); return }
    let x_value: ParseF64 = str_parse_f64_at(body as string, x_pos)
    let y_value: ParseF64 = str_parse_f64_at(body as string, y_pos)
    let z_value: ParseF64 = str_parse_f64_at(body as string, z_pos)
    if x_value.ok == false or y_value.ok == false or z_value.ok == false { send_response(fd, 400, "application/json", make_error("Cell move coordinates must be numeric")); return }
    let dx: f64 = x_value.value - cels[cell_id].cex
    let dy: f64 = y_value.value - cels[cell_id].cey
    let dz: f64 = z_value.value - cels[cell_id].cez
    let mut i: i32 = 1
    while i <= nd {
        if node[i].icel == cell_id {
            node[i].x = node[i].x + dx
            node[i].y = node[i].y + dy
            node[i].z = node[i].z + dz
        }
        i = i + 1
    }
    cels[cell_id].cex = x_value.value
    cels[cell_id].cey = y_value.value
    cels[cell_id].cez = z_value.value
    if neighbor_build() == false {
        i = 1
        while i <= nd {
            if node[i].icel == cell_id {
                node[i].x = node[i].x - dx
                node[i].y = node[i].y - dy
                node[i].z = node[i].z - dz
            }
            i = i + 1
        }
        cels[cell_id].cex = cels[cell_id].cex - dx
        cels[cell_id].cey = cels[cell_id].cey - dy
        cels[cell_id].cez = cels[cell_id].cez - dz
        let _restore: bool = neighbor_build()
        send_response(fd, 422, "application/json", make_error("Moved cell breaks the current neighbor graph")); return
    }
    send_model_response(fd, getot, false, true)
}

