    send_model_response(fd, getot, false, true)
}

function handle_cell_edit(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let cell_id: i32 = json_integer(body, body_len, "cellId", 0)
    if cell_id < 1 or cell_id > ncels { send_response(fd, 400, "application/json", make_error("Cell index is outside the active model")); return }
    let field_buffer: ptr<u8> = malloc(64) as ptr<u8>
    if field_buffer == null { send_response(fd, 500, "application/json", make_error("Out of memory")); return }
    let field_length: i32 = decode_json_string(body, body_len, "field", field_buffer, 64)
    let value_pos: i32 = json_key_value(body, body_len, "value")
    if field_length < 0 or value_pos < 0 { free(field_buffer as ptr<void>); send_response(fd, 400, "application/json", make_error("Cell edit requires a field and numeric value")); return }
    let parsed: ParseF64 = str_parse_f64_at(body as string, value_pos)
    if parsed.ok == false { free(field_buffer as ptr<void>); send_response(fd, 400, "application/json", make_error("Cell edit value is invalid")); return }
    if apply_cell_property(cell_id, field_buffer as string, parsed.value) == false { free(field_buffer as ptr<void>); send_response(fd, 400, "application/json", make_error("Unsupported cell property")); return }
    free(field_buffer as ptr<void>)
    send_model_response(fd, getot, false, true)
}

function json_true(body: ptr<u8>, length: i32, key: string) -> bool {
    let p: i32 = json_key_value(body, length, key)
    return p >= 0 and p + 3 < length and body[p] == 116 and body[p + 1] == 114 and body[p + 2] == 117 and body[p + 3] == 101
}

function count_unique(field: i32) -> i32 {
    let values: ptr<i32> = malloc(((nd + 1) * 4) as i64) as ptr<i32>
    if values == null { return 0 }
    let mut count: i32 = 0
    let mut i: i32 = 1
    while i <= nd {
        let value: i32 = if field == 0 { node[i].icel } else { node[i].tipus }
        let mut j: i32 = 0
        let mut seen: bool = false
        while j < count {
            if values[j] == value { seen = true; break }
            j = j + 1
        }
        if seen == false { values[count] = value; count = count + 1 }
        i = i + 1
    }
    free(values as ptr<void>)
    return count
}

function node_elongation_factor(node_id: i32) -> f64 {
    let property: i32 = 52
    if npag == null or npag[property] <= 0 { return 1.0 }
    let mut factor: f64 = 1.0
    let mut slot: i32 = 1
    while slot <= npag[property] {
        let gene_id: i32 = whonpag[property * (ng + 1) + slot]
        let expression: f64 = gex[gene_expression_index(node_id, gene_id)]
        if expression > 0.0 { factor = factor + expression * gene_effects[gene_effect_index(gene_id, property)] }
        slot = slot + 1
    }
    if factor > maxelong { factor = maxelong }
    return factor
}

function json_put_f64(out: ptr<ByteBuf>, value: f64) -> void {
    if value == 0.0 { bb_puts(out, "0.0000000000000000e+00"); return }
    let negative: bool = value < 0.0
    let mut mantissa: f64 = if negative { 0.0 - value } else { value }
    let mut exponent: i32 = 0
    while mantissa >= 10.0 { mantissa = mantissa / 10.0; exponent = exponent + 1 }
    while mantissa < 1.0 { mantissa = mantissa * 10.0; exponent = exponent - 1 }
    let mut digits: i64 = (mantissa * 10000000000000000.0 + 0.5) as i64
    if digits >= 100000000000000000 { digits = digits / 10; exponent = exponent + 1 }
    if negative { bb_putc(out, 45) }
    let mut divisor: i64 = 10000000000000000
    let mut digit_index: i32 = 0
    while digit_index < 17 {
        if digit_index == 1 { bb_putc(out, 46) }
        let digit: i64 = digits / divisor
        bb_putc(out, (48 + digit) as u8)
        digits = digits % divisor
        divisor = divisor / 10
        digit_index = digit_index + 1
    }
    bb_putc(out, 101)
    let exponent_negative: bool = exponent < 0
    if exponent_negative { bb_putc(out, 45) } else { bb_putc(out, 43) }
    let exponent_magnitude: i32 = if exponent_negative { 0 - exponent } else { exponent }
    if exponent_magnitude < 10 { bb_putc(out, 48) }
    bb_put_i32(out, exponent_magnitude)
}

function make_model_json(iteration: i32, include_snapshot: bool, batch_complete: bool) -> string {
    let out: ptr<ByteBuf> = bb_new(8192)
    write_model_json(out, iteration, include_snapshot, batch_complete, true)
    let result: string = bb_str(out)
    bb_free(out)
    return result
}

# The model as JSON. With include_arrays false the edges and nodes arrays
# are left out; make_model_binary then appends them as packed numbers.
function write_model_json(out: ptr<ByteBuf>, iteration: i32, include_snapshot: bool, batch_complete: bool, include_arrays: bool) -> void {
    bb_puts(out, "{\"iterations\":")
    bb_put_i32(out, iteration)
    bb_puts(out, ",\"simulatedTime\":")
    json_put_f64(out, rtime)
    bb_puts(out, ",\"batchComplete\":")
    bb_puts(out, if batch_complete { "true" } else { "false" })
    bb_puts(out, ",\"geneCount\":")
    bb_put_i32(out, ng)
    bb_puts(out, ",\"triangulationWarning\":")
    bb_put_i32(out, triangulation_warning)
    bb_puts(out, ",\"boxGrid\":{\"spacing\":")
    json_put_f64(out, rv)
    bb_puts(out, ",\"count\":")
    bb_put_i32(out, nboxes)
    bb_putc(out, 125)
    bb_puts(out, ",\"cells\":[")
    let mut cell_index: i32 = 1
    while cell_index <= ncels {
        if cell_index > 1 { bb_putc(out, 44) }
        let cell: Cel = cels[cell_index]
        bb_puts(out, "{\"id\":")
        bb_put_i32(out, cell_index)
        bb_puts(out, ",\"x\":")
        json_put_f64(out, cell.cex)
        bb_puts(out, ",\"y\":")
        json_put_f64(out, cell.cey)
        bb_puts(out, ",\"z\":")
        json_put_f64(out, cell.cez)
        bb_puts(out, ",\"polx\":")
        json_put_f64(out, cell.polx)
        bb_puts(out, ",\"poly\":")
        json_put_f64(out, cell.poly)
        bb_puts(out, ",\"polz\":")
        json_put_f64(out, cell.polz)
        bb_puts(out, ",\"phase\":")
        json_put_f64(out, cell.fase)
        bb_puts(out, ",\"time\":")
        json_put_f64(out, cell.temt)
        bb_puts(out, ",\"minsize_for_div\":")
        json_put_f64(out, cell.minsize_for_div)
        bb_puts(out, ",\"maxsize_for_div\":")
        json_put_f64(out, cell.maxsize_for_div)
        bb_puts(out, ",\"nodela\":")
        bb_put_i32(out, cell.nodela)
        bb_puts(out, ",\"type\":")
        bb_put_i32(out, cell.ctipus)
        bb_putc(out, 125)
        cell_index = cell_index + 1
    }
    if include_arrays {
    bb_puts(out, "],\"edges\":[")
    let mut edge_count: i32 = 0
    let mut edge_from: i32 = 1
    while edge_from <= nd {
        let mut slot: i32 = 1
        while slot <= nneigh[edge_from] {
            let edge_to: i32 = neigh[edge_from * neigh_ld + slot]
            if edge_to > edge_from and dneigh[edge_from * neigh_ld + slot] < node[edge_from].add + node[edge_to].add {
                if edge_count > 0 { bb_putc(out, 44) }
                bb_puts(out, "{\"a\":")
                bb_put_i32(out, edge_from)
                bb_puts(out, ",\"b\":")
                bb_put_i32(out, edge_to)
                bb_puts(out, ",\"inter\":")
                bb_puts(out, if node[edge_from].icel != node[edge_to].icel { "true" } else { "false" })
                bb_putc(out, 125)
                edge_count = edge_count + 1
            }
            slot = slot + 1
        }
        edge_from = edge_from + 1
    }
    bb_puts(out, "],\"nodes\":[")
    let mut i: i32 = 1
    while i <= nd {
        if i > 1 { bb_putc(out, 44) }
        let n: Nod = node[i]
        bb_puts(out, "{\"id\":")
        bb_put_i32(out, i)
        bb_puts(out, ",\"x\":")
        json_put_f64(out, n.x)
        bb_puts(out, ",\"y\":")
        json_put_f64(out, n.y)
        bb_puts(out, ",\"z\":")
        json_put_f64(out, n.z)
        bb_puts(out, ",\"radius\":")
        json_put_f64(out, n.add)
        bb_puts(out, ",\"eqd\":")
        json_put_f64(out, n.eqd)
        bb_puts(out, ",\"fixed\":")
        bb_puts(out, if n.fix != 0 { "true" } else { "false" })
        bb_puts(out, ",\"type\":")
        bb_put_i32(out, n.tipus)
        bb_puts(out, ",\"cell\":")
        bb_put_i32(out, n.icel)
        bb_puts(out, ",\"energy\":")
        json_put_f64(out, n.e)
        bb_puts(out, ",\"you\":")
        json_put_f64(out, n.you)
        bb_puts(out, ",\"adh\":")
        json_put_f64(out, n.adh)
        bb_puts(out, ",\"rep\":")
        json_put_f64(out, n.rep)
        bb_puts(out, ",\"rec\":")
        json_put_f64(out, n.rec)
        bb_puts(out, ",\"erp\":")
        json_put_f64(out, n.erp)
        bb_puts(out, ",\"est\":")
        json_put_f64(out, n.est)
        bb_puts(out, ",\"eqs\":")
        json_put_f64(out, n.eqs)
        bb_puts(out, ",\"hoo\":")
        json_put_f64(out, n.hoo)
        bb_puts(out, ",\"mov\":")
        json_put_f64(out, n.mov)
        bb_puts(out, ",\"dmo\":")
        json_put_f64(out, n.dmo)
        bb_puts(out, ",\"x0\":")
        json_put_f64(out, n.orix)
        bb_puts(out, ",\"y0\":")
        json_put_f64(out, n.oriy)
        bb_puts(out, ",\"z0\":")
        json_put_f64(out, n.oriz)
        bb_puts(out, ",\"ecm\":")
        json_put_f64(out, n.ecm)
        bb_puts(out, ",\"cod\":")
        json_put_f64(out, n.cod)
        bb_puts(out, ",\"grd\":")
        json_put_f64(out, n.grd)
        bb_puts(out, ",\"pld\":")
        json_put_f64(out, n.pld)
        bb_puts(out, ",\"vod\":")
        json_put_f64(out, n.vod)
        bb_puts(out, ",\"dif\":")
        json_put_f64(out, n.dif)
        bb_puts(out, ",\"kfi\":")
        json_put_f64(out, n.kfi)
        bb_puts(out, ",\"pla\":")
        json_put_f64(out, n.pla)
        bb_puts(out, ",\"kvol\":")
        json_put_f64(out, n.kvol)
        bb_puts(out, ",\"other\":")
        bb_put_i32(out, n.altre)
        bb_puts(out, ",\"marge\":")
        bb_put_i32(out, n.marge)
        bb_puts(out, ",\"talone\":")
        bb_put_i32(out, n.talone)
        bb_puts(out, ",\"ndiv\":")
        bb_put_i32(out, n.ndiv)
        bb_puts(out, ",\"phase\":")
        json_put_f64(out, if n.tipus < 4 and n.icel > 0 { cels[n.icel].fase } else { 0.0 })
        bb_puts(out, ",\"lineage\":")
        bb_put_i32(out, nodeo[i].icel)
        bb_puts(out, ",\"box\":")
        bb_put_i32(out, neighbor_box_head(i))
        bb_puts(out, ",\"elongationFactor\":")
        json_put_f64(out, node_elongation_factor(i))
        bb_puts(out, ",\"moveX\":")
        json_put_f64(out, px[i])
        bb_puts(out, ",\"moveY\":")
        json_put_f64(out, py[i])
        bb_puts(out, ",\"moveZ\":")
        json_put_f64(out, pz[i])
        bb_puts(out, ",\"repX\":")
        json_put_f64(out, vcilx[i])
        bb_puts(out, ",\"repY\":")
        json_put_f64(out, vcily[i])
        bb_puts(out, ",\"repZ\":")
        json_put_f64(out, vcilz[i])
        bb_puts(out, ",\"lateralX\":")
        json_put_f64(out, vtorx[i])
        bb_puts(out, ",\"lateralY\":")
        json_put_f64(out, vtory[i])
        bb_puts(out, ",\"lateralZ\":")
        json_put_f64(out, vtorz[i])
        bb_puts(out, ",\"axialX\":")
        json_put_f64(out, vstorx[i])
        bb_puts(out, ",\"axialY\":")
        json_put_f64(out, vstory[i])
        bb_puts(out, ",\"axialZ\":")
        json_put_f64(out, vstorz[i])
        bb_puts(out, ",\"genes\":[")
        let mut gene_index: i32 = 1
        while gene_index <= ng {
            if gene_index > 1 { bb_putc(out, 44) }
            json_put_f64(out, gex[gene_expression_index(i, gene_index)])
            gene_index = gene_index + 1
        }
        bb_putc(out, 93)
        bb_putc(out, 125)
        i = i + 1
    }
    }
    bb_puts(out, "],\"count\":")
    bb_put_i32(out, nd)
    bb_puts(out, ",\"session\":\"")
    bb_puts(out, SESSION_ID)
    bb_puts(out, "\",\"experiment\":")
    write_json_string(out, session_name)
    bb_puts(out, ",\"cellCount\":")
    bb_put_i32(out, count_unique(0))
    bb_puts(out, ",\"typeCount\":")
    bb_put_i32(out, count_unique(1))
    if include_snapshot {
        if write_snapshot(snapshot_file) {
            let snapshot: FileRead = io_read_file(snapshot_file)
            if snapshot.ok {
                bb_puts(out, ",\"snapshot\":")
                write_json_string(out, snapshot.data)
                free(snapshot.data as ptr<void>)
            }
        }
    }
    bb_putc(out, 125)
}

function make_batch_progress_json() -> string {
    let out: ptr<ByteBuf> = bb_new(96)
    bb_puts(out, "{\"iterations\":")
    bb_put_i32(out, getot)
    bb_puts(out, ",\"simulatedTime\":")
    json_put_f64(out, rtime)
    bb_puts(out, ",\"batchComplete\":false}")
    let result: string = bb_str(out)
    bb_free(out)
    return result
}

function make_iteration_progress_json() -> string {
    let out: ptr<ByteBuf> = bb_new(96)
    bb_puts(out, "{\"iterations\":")
    bb_put_i32(out, getot)
    bb_puts(out, ",\"simulatedTime\":")
    json_put_f64(out, rtime)
    bb_puts(out, ",\"batchComplete\":true}")
    let result: string = bb_str(out)
    bb_free(out)
    return result
}

function make_error(message: string) -> string {
    let out: ptr<ByteBuf> = bb_new(128)
    bb_puts(out, "{\"error\":")
    write_json_string(out, message)
    bb_putc(out, 125)
    let result: string = bb_str(out)
    bb_free(out)
    return result
}

# Packed model frame for the viewer, requested with {"binary": true}.
# Layout, little endian:
#   "EMB1", u32 meta_len, meta JSON (write_model_json without arrays),
#   padding to 8 bytes, u32 node_count, u32 float_fields, u32 int_fields,
#   u32 gene_count, f64[node_count * float_fields], i32[node_count * int_fields],
#   f64[node_count * gene_count], u32 edge_count, u32 zero,
#   i32[edge_count * 3] as (a, b, inter).
# The field order is BINARY_FLOAT_FIELDS / BINARY_INT_FIELDS in ui/index.html.
const BINARY_FLOAT_FIELDS: i32 = 42
const BINARY_INT_FIELDS: i32 = 10

function bb_put_u32(out: ptr<ByteBuf>, value: i32) -> void {
    let mut word: i32 = value
    bb_put_bytes(out, &word as ptr<u8>, 4)
}

function make_model_binary(iteration: i32, include_snapshot: bool, batch_complete: bool) -> ptr<ByteBuf> {
    let meta: ptr<ByteBuf> = bb_new(8192)
    write_model_json(meta, iteration, include_snapshot, batch_complete, false)
    let node_count: i32 = nd
    let float_bytes: i64 = node_count as i64 * BINARY_FLOAT_FIELDS as i64 * 8
    let int_bytes: i64 = node_count as i64 * BINARY_INT_FIELDS as i64 * 4
    let gene_bytes: i64 = node_count as i64 * ng as i64 * 8
    let out: ptr<ByteBuf> = bb_new((bb_len(meta) as i64 + float_bytes + int_bytes + gene_bytes + 65536) as i32)
    bb_puts(out, "EMB1")
    bb_put_u32(out, bb_len(meta))
    bb_put_bytes(out, bb_cstr(meta) as ptr<u8>, bb_len(meta))
    bb_free(meta)
    while (bb_len(out) % 8) != 0 { bb_putc(out, 32) }
    bb_put_u32(out, node_count)
    bb_put_u32(out, BINARY_FLOAT_FIELDS)
    bb_put_u32(out, BINARY_INT_FIELDS)
    bb_put_u32(out, ng)
    let floats: ptr<f64> = malloc(float_bytes + 8) as ptr<f64>
    let ints: ptr<i32> = malloc(int_bytes + 8) as ptr<i32>
    let genes: ptr<f64> = malloc(gene_bytes + 8) as ptr<f64>
    if floats == null or ints == null or genes == null {
        bb_free(out)
        return null
    }
    let mut i: i32 = 1
    while i <= node_count {
        let n: Nod = node[i]
        let f: i32 = (i - 1) * BINARY_FLOAT_FIELDS
        floats[f + 0] = n.x; floats[f + 1] = n.y; floats[f + 2] = n.z; floats[f + 3] = n.add; floats[f + 4] = n.eqd
        floats[f + 5] = n.e; floats[f + 6] = n.you; floats[f + 7] = n.adh; floats[f + 8] = n.rep; floats[f + 9] = n.rec
        floats[f + 10] = n.erp; floats[f + 11] = n.est; floats[f + 12] = n.eqs; floats[f + 13] = n.hoo; floats[f + 14] = n.mov
        floats[f + 15] = n.dmo; floats[f + 16] = n.orix; floats[f + 17] = n.oriy; floats[f + 18] = n.oriz; floats[f + 19] = n.ecm
        floats[f + 20] = n.cod; floats[f + 21] = n.grd; floats[f + 22] = n.pld; floats[f + 23] = n.vod; floats[f + 24] = n.dif
        floats[f + 25] = n.kfi; floats[f + 26] = n.pla; floats[f + 27] = n.kvol
        floats[f + 28] = if n.tipus < 4 and n.icel > 0 { cels[n.icel].fase } else { 0.0 }
        floats[f + 29] = node_elongation_factor(i)
        floats[f + 30] = px[i]; floats[f + 31] = py[i]; floats[f + 32] = pz[i]
        floats[f + 33] = vcilx[i]; floats[f + 34] = vcily[i]; floats[f + 35] = vcilz[i]
        floats[f + 36] = vtorx[i]; floats[f + 37] = vtory[i]; floats[f + 38] = vtorz[i]
        floats[f + 39] = vstorx[i]; floats[f + 40] = vstory[i]; floats[f + 41] = vstorz[i]
        let k: i32 = (i - 1) * BINARY_INT_FIELDS
        ints[k + 0] = i; ints[k + 1] = if n.fix != 0 { 1 } else { 0 }; ints[k + 2] = n.tipus; ints[k + 3] = n.icel
        ints[k + 4] = n.altre; ints[k + 5] = n.marge; ints[k + 6] = n.talone; ints[k + 7] = n.ndiv
        ints[k + 8] = nodeo[i].icel; ints[k + 9] = neighbor_box_head(i)
        let g: i32 = (i - 1) * ng
        let mut gene_index: i32 = 1
        while gene_index <= ng {
            genes[g + gene_index - 1] = gex[gene_expression_index(i, gene_index)]
            gene_index = gene_index + 1
        }
        i = i + 1
    }
    bb_put_bytes(out, floats as ptr<u8>, float_bytes as i32)
    bb_put_bytes(out, ints as ptr<u8>, int_bytes as i32)
    bb_put_bytes(out, genes as ptr<u8>, gene_bytes as i32)
    free(floats as ptr<void>); free(ints as ptr<void>); free(genes as ptr<void>)
    let mut edge_count: i32 = 0
    let mut pass: i32 = 0
    while pass < 2 {
        if pass == 1 { bb_put_u32(out, edge_count); bb_put_u32(out, 0) }
        let mut edge_from: i32 = 1
        while edge_from <= node_count {
            let mut slot: i32 = 1
            while slot <= nneigh[edge_from] {
                let edge_to: i32 = neigh[edge_from * neigh_ld + slot]
                if edge_to > edge_from and dneigh[edge_from * neigh_ld + slot] < node[edge_from].add + node[edge_to].add {
                    if pass == 0 { edge_count = edge_count + 1 }
                    else {
                        bb_put_u32(out, edge_from)
                        bb_put_u32(out, edge_to)
                        bb_put_u32(out, if node[edge_from].icel != node[edge_to].icel { 1 } else { 0 })
                    }
                }
                slot = slot + 1
            }
            edge_from = edge_from + 1
        }
        pass = pass + 1
    }
    return out
}

function send_all(fd: i32, bytes: ptr<u8>, length: i32) -> bool {
    let mut sent: i32 = 0
    while sent < length {
        let n: i32 = flow_rt_tcp_send(fd, &bytes[sent] as ptr<void>, length - sent)
        if n <= 0 { return false }
        sent = sent + n
    }
    return true
}

function status_reason(status: i32) -> string {
    if status == 200 { return "OK" }
    if status == 400 { return "Bad Request" }
    if status == 404 { return "Not Found" }
    if status == 422 { return "Unprocessable Content" }
    if status == 500 { return "Internal Server Error" }
    return "OK"
}

function send_response(fd: i32, status: i32, content_type: string, body: string) -> void {
    let body_len: i32 = strlen(body) as i32
    let header: ptr<ByteBuf> = bb_new(192)
    bb_puts(header, "HTTP/1.1 "); bb_put_i32(header, status); bb_putc(header, 32); bb_puts(header, status_reason(status))
    bb_puts(header, "\r\nContent-Type: "); bb_puts(header, content_type)
    bb_puts(header, "\r\nContent-Length: "); bb_put_i32(header, body_len)
    bb_puts(header, "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
    let _h: bool = send_all(fd, bb_cstr(header) as ptr<u8>, bb_len(header))
    bb_free(header)
    if body_len > 0 { let _b: bool = send_all(fd, body as ptr<u8>, body_len) }
}

function send_file_read_response(fd: i32, status: i32, content_type: string, file: FileRead, encoding: string) -> void {
    if file.ok {
        send_encoded_response(fd, status, content_type, file.data as ptr<u8>, file.len, encoding)
        free(file.data as ptr<void>)
    } else {
        send_response(fd, status, "text/plain; charset=utf-8", "Not found")
    }
}

function send_sized_response(fd: i32, status: i32, content_type: string, data: ptr<u8>, data_len: i64) -> void {
    send_encoded_response(fd, status, content_type, data, data_len, "")
}

function send_encoded_response(fd: i32, status: i32, content_type: string, data: ptr<u8>, data_len: i64, encoding: string) -> void {
    let header: ptr<ByteBuf> = bb_new(224)
    bb_puts(header, "HTTP/1.1 "); bb_put_i32(header, status); bb_putc(header, 32); bb_puts(header, status_reason(status))
    bb_puts(header, "\r\nContent-Type: "); bb_puts(header, content_type)
    bb_puts(header, "\r\nContent-Length: "); bb_put_i64(header, data_len)
    if encoding != "" { bb_puts(header, "\r\nContent-Encoding: "); bb_puts(header, encoding) }
    bb_puts(header, "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
    let _h: bool = send_all(fd, bb_cstr(header) as ptr<u8>, bb_len(header))
    bb_free(header)
    if data_len > 0 { let _b: bool = send_all(fd, data, data_len as i32) }
}

function send_owned_response(fd: i32, status: i32, content_type: string, body: string) -> void {
    send_response(fd, status, content_type, body)
    free(body as ptr<void>)
}

# Set per request from {"binary": true} in the POST body.
let mut request_wants_binary: bool = false

function send_model_response(fd: i32, iteration: i32, include_snapshot: bool, batch_complete: bool) -> void {
    if request_wants_binary {
        let frame: ptr<ByteBuf> = make_model_binary(iteration, include_snapshot, batch_complete)
        if frame != null {
            let length: i32 = bb_len(frame)
            let header: ptr<ByteBuf> = bb_new(160)
            bb_puts(header, "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: "); bb_put_i32(header, length)
            bb_puts(header, "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n")
            let _h: bool = send_all(fd, bb_cstr(header) as ptr<u8>, bb_len(header))
            bb_free(header)
            let _b: bool = send_all(fd, bb_cstr(frame) as ptr<u8>, length)
            bb_free(frame)
            return
        }
    }
    let response: string = make_model_json(iteration, include_snapshot, batch_complete)
    send_owned_response(fd, 200, "application/json; charset=utf-8", response)
}

function output_slug(value: string) -> string {
    let source: ptr<u8> = value as ptr<u8>
    let length: i32 = strlen(value) as i32
    let out: ptr<u8> = calloc(96, 1) as ptr<u8>
    let mut used: i32 = 0
    let mut i: i32 = 0
    while i < length and used < 80 {
        let c: i32 = source[i] as i32
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95 {
            out[used] = c as u8
            used = used + 1
        } elif used > 0 and out[used - 1] != 95 {
            out[used] = 95
            used = used + 1
        }
        i = i + 1
    }
    while used > 0 and out[used - 1] == 95 { used = used - 1 }
    if used == 0 { return "simulation" }
    out[used] = 0
    return out as string
}

function output_label(body: ptr<u8>, body_len: i32) -> string {
    let raw: ptr<u8> = calloc(128, 1) as ptr<u8>
    if raw == null { return "" }
    let length: i32 = decode_json_string(body, body_len, "label", raw, 128)
    if length <= 0 { return "" }
    let out: ptr<u8> = calloc(66, 1) as ptr<u8>
    let mut i: i32 = 0
    let mut used: i32 = 0
    while i < length and i < 64 {
        let c: i32 = raw[i] as i32
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 95 { out[used] = raw[i]; used = used + 1 }
        i = i + 1
    }
    free(raw as ptr<void>)
    return out as string
}

function base64_digit(value: i32) -> i32 {
    if value >= 65 and value <= 90 { return value - 65 }
    if value >= 97 and value <= 122 { return value - 97 + 26 }
    if value >= 48 and value <= 57 { return value - 48 + 52 }
    if value == 43 { return 62 }
    if value == 47 { return 63 }
    return -1
}

function decode_image(body: ptr<u8>, body_len: i32, output: ptr<u8>, capacity: i32, field: string) -> i32 {
    let encoded: ptr<u8> = calloc(12000000, 1) as ptr<u8>
    if encoded == null { return -1 }
    let length: i32 = decode_json_string(body, body_len, field, encoded, 12000000)
    if length <= 0 { free(encoded as ptr<void>); return -1 }
    let mut start: i32 = 0
    while start < length and encoded[start] != 44 { start = start + 1 }
    if start < length { start = start + 1 }
    let mut accumulator: i32 = 0
    let mut bits: i32 = 0
    let mut written: i32 = 0
    let mut i: i32 = start
    while i < length {
        let c: i32 = encoded[i] as i32
        if c == 61 { break }
        let digit: i32 = base64_digit(c)
        if digit < 0 { free(encoded as ptr<void>); return -1 }
        accumulator = accumulator * 64 + digit
        bits = bits + 6
        if bits >= 8 {
            bits = bits - 8
            if written >= capacity { free(encoded as ptr<void>); return -1 }
            output[written] = ((accumulator >> bits) & 255) as u8
            written = written + 1
            accumulator = accumulator & ((1 << bits) - 1)
        }
        i = i + 1
    }
    free(encoded as ptr<void>)
    return written
}

function handle_save_image(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let _root: i32 = mkdir("images", 511)
    let folder: string = "images/" + output_slug(session_name)
    let _folder: i32 = mkdir(folder, 511)
    let path: string = folder + "/" + output_label(body, body_len) + format_i64(getot as i64) + ".png"
    let image: ptr<u8> = calloc(8000000, 1) as ptr<u8>
    if image == null { send_response(fd, 500, "application/json", make_error("Out of memory")); return }
    let length: i32 = decode_image(body, body_len, image, 8000000, "image")
    if length < 8 or image[0] != 137 or image[1] != 80 or image[2] != 78 or image[3] != 71 {
        free(image as ptr<void>)
        send_response(fd, 400, "application/json", make_error("Image data must be a PNG"))
        return
    }
    let written: bool = io_write_bytes(path, image, length as i64)
    free(image as ptr<void>)
    if written == false { send_response(fd, 500, "application/json", make_error("Could not write image")); return }
    send_response(fd, 200, "application/json; charset=utf-8", "{\"path\":\"" + path + "\",\"iteration\":" + format_i64(getot as i64) + "}")
}

function handle_save_movie(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let folder: string = "output/" + output_slug(session_name)
    let _root: i32 = mkdir("output", 511)
    let _folder: i32 = mkdir(folder, 511)
    let prefix: string = output_label(body, body_len)
    if prefix == "" { prefix = output_slug(session_name) }
    let movie_data: ptr<u8> = calloc(8000000, 1) as ptr<u8>
    if movie_data == null { send_response(fd, 500, "application/json", make_error("Out of memory")); return }
    let length: i32 = decode_image(body, body_len, movie_data, 8000000, "movie")
    if length < 12 or movie_data[0] != 26 or movie_data[1] != 69 or movie_data[2] != 223 or movie_data[3] != 163 {
        free(movie_data as ptr<void>)
        send_response(fd, 400, "application/json", make_error("Movie data must be a WebM recording"))
        return
    }
    let webm_path: string = folder + "/" + prefix + ".webm"
    let gif_path: string = folder + "/" + prefix + ".gif"
    let written: bool = io_write_bytes(webm_path, movie_data, length as i64)
    free(movie_data as ptr<void>)
    if written == false { send_response(fd, 500, "application/json", make_error("Could not write movie recording")); return }
    let command = proc_cmd("ffmpeg")
    proc_arg(command, "-y")
    proc_arg(command, "-loglevel")
    proc_arg(command, "error")
    proc_arg(command, "-i")
    proc_arg(command, webm_path)
    proc_arg(command, "-vf")
    proc_arg(command, "fps=20,scale=800:-1:flags=lanczos")
    proc_arg(command, "-loop")
    proc_arg(command, "0")
    proc_arg(command, gif_path)
    proc_timeout_ms(command, 120000)
    let result: ptr<ProcResult> = proc_run(command)
    if result.exit_code != 0 {
        send_response(fd, 500, "application/json", make_error("Could not create GIF with ffmpeg: " + result.error + result.stderr))
        return
    }
    let _removed: i32 = unlink(webm_path)
    send_response(fd, 200, "application/json; charset=utf-8", "{\"path\":\"" + gif_path + "\",\"iteration\":" + format_i64(getot as i64) + "}")
}

function handle_save_snapshot(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let _root: i32 = mkdir("output", 511)
    let folder: string = "output/" + output_slug(session_name)
    let _folder: i32 = mkdir(folder, 511)
    let path: string = folder + "/" + output_label(body, body_len) + format_i64(getot as i64) + ".dat"
    if write_snapshot(path) == false { send_response(fd, 500, "application/json", make_error("Could not write snapshot")); return }
    send_response(fd, 200, "application/json; charset=utf-8", "{\"path\":\"" + path + "\",\"iteration\":" + format_i64(getot as i64) + "}")
}

function restore_previous_session(was_active: bool, previous_name: string) -> bool {
    if was_active == false {
        session_active = false
        session_name = previous_name
        return true
    }
    if read_snapshot_parameters(rollback_file) != 0 { return false }
    neighbor_clear_warning()
    inialea3d(nparti)
    if nd > 1 {
        if neighbor_build() == false { return false }
        if ffu[24] == 0 and restore_neighbors() == false { return false }
    }
    session_name = previous_name
    session_active = true
    return true
}

function handle_start(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    model_batch_reset()
    let previous_active: bool = session_active
    let previous_name: string = session_name
    if previous_active and write_snapshot(rollback_file) == false {
        send_response(fd, 500, "application/json", make_error("Could not preserve the active simulation"))
        return
    }
    let input: ptr<u8> = malloc(8000001) as ptr<u8>
    if input == null { send_response(fd, 500, "application/json", make_error("Out of memory")); return }
    let input_len: i32 = decode_json_string(body, body_len, "inputText", input, 8000001)
    let mut path: string = ""
    let mut uploaded_file: bool = false
    let mut next_session_name: string = ""
    let mut next_session_name_owned: ptr<u8> = null
    if input_len >= 0 {
        uploaded_file = true
        upload_counter = upload_counter + 1
        path = "/tmp/embryomaker-flow-" + format_i64(proc_pid() as i64) + "-" + format_i64(upload_counter as i64) + ".dat"
        if io_write_bytes(path, input, input_len as i64) == false {
            free(input as ptr<void>)
            send_response(fd, 500, "application/json", make_error("Could not write uploaded input"))
            return
        }
        next_session_name = "Custom input"
        let file_name: ptr<u8> = malloc(256) as ptr<u8>
        if file_name != null {
            let file_len: i32 = decode_json_string(body, body_len, "fileName", file_name, 256)
            if file_len > 0 { next_session_name = file_name as string; next_session_name_owned = file_name }
            else { free(file_name as ptr<void>) }
        }
        free(input as ptr<void>)
    } else {
        free(input as ptr<void>)
        let id: ptr<u8> = malloc(128) as ptr<u8>
        if id == null { send_response(fd, 500, "application/json", make_error("Out of memory")); return }
        let id_len: i32 = decode_json_string(body, body_len, "example", id, 128)
        let id_value: string = if id_len < 0 { "migration" } else { id as string }
        let mut index: i32 = 0
        while index < EXAMPLE_COUNT and example_id(index) != id_value { index = index + 1 }
        free(id as ptr<void>)
        if index >= EXAMPLE_COUNT {
            send_response(fd, 400, "application/json", make_error("Unknown EmbryoMaker example"))
            return
        }
        path = example_path(index)
        next_session_name = example_name(index)
    }
    let status: i32 = read_snapshot_parameters(path)
    if uploaded_file { let _r: i32 = unlink(path) }
    if status != 0 {
        let parser_status: i32 = snapshot_error
        if next_session_name_owned != null { free(next_session_name_owned as ptr<void>) }
        if restore_previous_session(previous_active, previous_name) == false {
            session_active = false
            send_response(fd, 500, "application/json", make_error("Could not restore the active simulation after rejecting the input"))
            return
        }
        send_response(fd, 422, "application/json", make_error("Could not load EmbryoMaker input. Parser status " + format_i64(parser_status as i64)))
        return
    }
    neighbor_clear_warning()
    inialea3d(nparti)
    if nd > 1 {
        if neighbor_build() == false {
            let build_error: i32 = neighbor_error
            if next_session_name_owned != null { free(next_session_name_owned as ptr<void>) }
            if restore_previous_session(previous_active, previous_name) == false { session_active = false }
            let mut message: string = "Could not prepare EmbryoMaker neighbors. Status " + format_i64(build_error as i64)
            if build_error == 10 { message = "Gabriel filtering requires a triangulation or legacy adjacency neighbor mode." }
            send_response(fd, 422, "application/json", make_error(message))
            return
        }
        if ffu[24] == 0 and restore_neighbors() == false {
            let restore_error: i32 = neighbor_error
            if next_session_name_owned != null { free(next_session_name_owned as ptr<void>) }
            if restore_previous_session(previous_active, previous_name) == false { session_active = false }
            send_response(fd, 422, "application/json", make_error("Could not restore EmbryoMaker neighbors. Status " + format_i64(restore_error as i64)))
            return
        }
    }
    if session_name_owned != null { free(session_name_owned as ptr<void>) }
    session_name = next_session_name
    session_name_owned = next_session_name_owned
    session_active = true
    send_model_response(fd, getot, false, true)
}

# Compute mode for the running server: {"mode": "serial"|"threads"|"preview"|"exact64"}.
# serial keeps every pass on one core, threads uses the worker pool (its
# size is fixed at start by EMBRYO_THREADS), preview adds the float32 GPU
# force kernel, exact64 the software binary64 one. An empty body reports.
function compute_mode_name() -> string {
    let mode: i32 = gpu_mode()
    if mode == GPU_MODE_PREVIEW { return "preview" }
    if mode == GPU_MODE_EXACT64 { return "exact64" }
    if parallel_workers() > 1 and compute_threads_enabled { return "threads" }
    return "serial"
}

let mut compute_threads_enabled: bool = true

function make_compute_json() -> string {
    let out: ptr<ByteBuf> = bb_new(256)
    bb_puts(out, "{\"mode\":")
    write_json_string(out, compute_mode_name())
    bb_puts(out, ",\"threads\":")
    bb_put_i32(out, if compute_threads_enabled { parallel_workers() } else { 1 })
    bb_puts(out, ",\"gpuForceCalls\":")
    bb_put_i32(out, force_gpu_calls)
    bb_puts(out, ",\"gpuForceFallbacks\":")
    bb_put_i32(out, force_gpu_fallbacks)
    bb_puts(out, ",\"parallelForceCalls\":")
    bb_put_i32(out, force_parallel_calls)
    bb_putc(out, 125)
    let result: string = bb_str(out)
    bb_free(out)
    return result
}

function handle_compute(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    let mode_position: i32 = json_key_value(body, body_len, "mode")
    if mode_position >= 0 {
        let mode: ptr<u8> = malloc(32) as ptr<u8>
        let mode_len: i32 = decode_json_string(body, body_len, "mode", mode, 31)
        let name: string = mode as string
        if mode_len > 0 {
            if name == "serial" { set_gpu_mode(GPU_MODE_OFF); compute_threads_enabled = false; set_parallel_threads_policy(2147483647) }
            elif name == "threads" { set_gpu_mode(GPU_MODE_OFF); compute_threads_enabled = true; set_parallel_threads_policy(512) }
            elif name == "preview" { set_gpu_mode(GPU_MODE_PREVIEW); compute_threads_enabled = true; set_parallel_threads_policy(512) }
            elif name == "exact64" { set_gpu_mode(GPU_MODE_EXACT64); compute_threads_enabled = true; set_parallel_threads_policy(512) }
            else { free(mode as ptr<void>); send_response(fd, 400, "application/json", make_error("Unknown compute mode.")); return }
            neighbor_gpu_reset()
        }
        free(mode as ptr<void>)
    }
    send_owned_response(fd, 200, "application/json; charset=utf-8", make_compute_json())
}

function handle_advance(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    let batch_mode: bool = json_key_value(body, body_len, "timeUnits") >= 0
    let steps: i32 = if batch_mode { json_integer(body, body_len, "timeUnits", 1) } else { json_integer(body, body_len, "steps", 1) }
    let maximum: i32 = if batch_mode { 50000 } else { 10000 }
    if steps < 0 or steps > maximum { send_response(fd, 400, "application/json", make_error("Advance amount is outside the supported range.")); return }
    if batch_mode {
        let token_position: i32 = json_key_value(body, body_len, "batchToken")
        if token_position >= 0 {
            let token: i32 = json_integer(body, body_len, "batchToken", 0)
            let chunk_size: i32 = json_integer(body, body_len, "maxIterations", 1)
            if token <= 0 or chunk_size < 1 or chunk_size > 64 {
                model_batch_reset()
                send_response(fd, 400, "application/json", make_error("Simulation batch token or chunk size is invalid."))
                return
            }
            if json_true(body, body_len, "startBatch") and model_batch_begin(token, steps) == false {
                send_response(fd, 400, "application/json", make_error("Could not begin simulation batch."))
                return
            }
            let progress: ModelBatchProgress = model_batch_advance_chunk(token, chunk_size)
            if progress.ok == false {
                send_response(fd, 422, "application/json", make_error("Simulation stopped. Flow model status " + format_i64(model_error as i64)))
                return
            }
            if progress.complete == false {
                send_owned_response(fd, 200, "application/json; charset=utf-8", make_batch_progress_json())
                return
            }
            let snapshot: bool = json_true(body, body_len, "includeSnapshot")
            send_model_response(fd, getot, snapshot, progress.complete)
            return
        }
        model_batch_reset()
        if advance_model_batch(steps) == false {
            send_response(fd, 422, "application/json", make_error("Simulation stopped. Flow model status " + format_i64(model_error as i64)))
            return
        }
        let snapshot: bool = json_true(body, body_len, "includeSnapshot")
        send_model_response(fd, getot, snapshot, true)
        return
    }
    let mut i: i32 = 0
    while i < steps {
        if advance_model_iteration() == false {
            send_response(fd, 422, "application/json", make_error("Simulation stopped. Flow model status " + format_i64(model_error as i64)))
            return
        }
        i = i + 1
    }
    if json_true(body, body_len, "progressOnly") {
        model_batch_reset()
        send_owned_response(fd, 200, "application/json; charset=utf-8", make_iteration_progress_json())
        return
    }
    let snapshot: bool = json_true(body, body_len, "includeSnapshot")
    model_batch_reset()
    send_model_response(fd, getot, snapshot, true)
}

function handle_slice_plot(fd: i32, body: ptr<u8>, body_len: i32) -> void {
    if session_active == false { send_response(fd, 404, "application/json", make_error("Simulation session expired. Reload the experiment.")); return }
    if nd < 1 { send_response(fd, 422, "application/json", make_error("The active model has no nodes")); return }
    let axis: i32 = json_integer(body, body_len, "axis", -1)
    let field: i32 = json_integer(body, body_len, "field", 0)
    let decoy: i32 = json_integer(body, body_len, "decoy", nd)
    let mut resolution: i32 = json_integer(body, body_len, "resolution", 450)
    if axis < 0 or axis > 2 or field < 0 or field > 4 or decoy < 1 or decoy > nd or resolution < 1 or resolution > 450 {
        send_response(fd, 400, "application/json", make_error("Slice axis, energy field, decoy node, or resolution is outside its supported range")); return
    }
    let plane_pos: i32 = json_key_value(body, body_len, "plane")
    let minx_pos: i32 = json_key_value(body, body_len, "minx")
    let maxx_pos: i32 = json_key_value(body, body_len, "maxx")
    let miny_pos: i32 = json_key_value(body, body_len, "miny")
    let maxy_pos: i32 = json_key_value(body, body_len, "maxy")
    let minz_pos: i32 = json_key_value(body, body_len, "minz")
    let maxz_pos: i32 = json_key_value(body, body_len, "maxz")
    if plane_pos < 0 or minx_pos < 0 or maxx_pos < 0 or miny_pos < 0 or maxy_pos < 0 or minz_pos < 0 or maxz_pos < 0 {
        send_response(fd, 400, "application/json", make_error("Slice plot requires a plane and three coordinate ranges")); return
    }
    let plane_value: ParseF64 = str_parse_f64_at(body as string, plane_pos)
    let minx_value: ParseF64 = str_parse_f64_at(body as string, minx_pos)
    let maxx_value: ParseF64 = str_parse_f64_at(body as string, maxx_pos)
    let miny_value: ParseF64 = str_parse_f64_at(body as string, miny_pos)
    let maxy_value: ParseF64 = str_parse_f64_at(body as string, maxy_pos)
    let minz_value: ParseF64 = str_parse_f64_at(body as string, minz_pos)
    let maxz_value: ParseF64 = str_parse_f64_at(body as string, maxz_pos)
    if plane_value.ok == false or minx_value.ok == false or maxx_value.ok == false or miny_value.ok == false or maxy_value.ok == false or minz_value.ok == false or maxz_value.ok == false {
        send_response(fd, 400, "application/json", make_error("Slice plot coordinates must be numeric")); return
    }
    if maxx_value.value <= minx_value.value or maxy_value.value <= miny_value.value or maxz_value.value <= minz_value.value {
        send_response(fd, 400, "application/json", make_error("Slice plot ranges must have positive width")); return
    }
    let sample_count: i32 = (resolution + 1) * (resolution + 1)
    let samples: ptr<f64> = calloc(sample_count as i64, 8) as ptr<f64>
    if samples == null { send_response(fd, 500, "application/json", make_error("Could not allocate the slice plot field")); return }
    let old_x: f64 = node[decoy].x
    let old_y: f64 = node[decoy].y
    let old_z: f64 = node[decoy].z
    let mut failed: bool = false
    let mut i: i32 = 0
    while i <= resolution and failed == false {
        let mut j: i32 = 0
        while j <= resolution and failed == false {
            let u: f64 = i as f64 / resolution as f64
            let v: f64 = j as f64 / resolution as f64
            if axis == 0 {
                node[decoy].x = plane_value.value
                node[decoy].y = miny_value.value + u * (maxy_value.value - miny_value.value)
                node[decoy].z = minz_value.value + v * (maxz_value.value - minz_value.value)
            } elif axis == 1 {
                node[decoy].x = minx_value.value + u * (maxx_value.value - minx_value.value)
                node[decoy].y = plane_value.value
                node[decoy].z = minz_value.value + v * (maxz_value.value - minz_value.value)
            } else {
                node[decoy].x = minx_value.value + u * (maxx_value.value - minx_value.value)
                node[decoy].y = miny_value.value + v * (maxy_value.value - miny_value.value)
                node[decoy].z = plane_value.value
            }
            if energia(decoy) == false { failed = true }
            let sample_index: i32 = i * (resolution + 1) + j
            let mut value: f64 = node[decoy].e
            if field == 1 { value = eadh[decoy] }
            elif field == 2 { value = eyou[decoy] }
            elif field == 3 { value = erep[decoy] }
            elif field == 4 { value = erepcel[decoy] }
            if value != value or value > 1e300 or value < -1e300 { failed = true }
            samples[sample_index] = value
            j = j + 1
        }
        i = i + 1
    }
    node[decoy].x = old_x
    node[decoy].y = old_y
    node[decoy].z = old_z
    let restored: bool = energia(decoy)
    if failed or restored == false {
        free(samples as ptr<void>)
        send_response(fd, 422, "application/json", make_error("Flow could not evaluate the requested OG slice energy field"))
        return
    }
    let mut minimum: f64 = samples[0]
    let mut maximum: f64 = samples[0]
    let mut index: i32 = 1
    while index < sample_count {
        if samples[index] < minimum { minimum = samples[index] }
        if samples[index] > maximum { maximum = samples[index] }
        index = index + 1
    }
    let out: ptr<ByteBuf> = bb_new(sample_count * 16 + 256)
    bb_puts(out, "{\"axis\":")
    bb_put_i32(out, axis)
    bb_puts(out, ",\"field\":")
    bb_put_i32(out, field)
    bb_puts(out, ",\"decoy\":")
    bb_put_i32(out, decoy)
    bb_puts(out, ",\"plane\":")
    json_put_f64(out, plane_value.value)
    bb_puts(out, ",\"resolution\":")
    bb_put_i32(out, resolution)
    bb_puts(out, ",\"minimum\":")
    json_put_f64(out, minimum)
    bb_puts(out, ",\"maximum\":")
    json_put_f64(out, maximum)
    bb_puts(out, ",\"values\":[")
    index = 0
    while index < sample_count {
        if index > 0 { bb_putc(out, 44) }
        json_put_f64(out, samples[index])
        index = index + 1
    }
    bb_puts(out, "]}")
    free(samples as ptr<void>)
    let response: string = bb_str(out)
    bb_free(out)
    send_owned_response(fd, 200, "application/json; charset=utf-8", response)
}

function route_request(fd: i32, request: HttpRequest) -> void {
    let bytes: ptr<u8> = request.bytes
    let body: ptr<u8> = &bytes[request.body_start]
    let body_len: i32 = request.body_length
    if bytes_equal(bytes, request.method_start, request.method_end, "GET") {
        if bytes_equal(bytes, request.path_start, request.path_end, "/api/display-config") {
            let config: FileRead = io_read_file("config_file.txt")
            if config.ok == false { config = io_read_file("reference/config_file.txt") }
            if config.ok { send_response(fd, 200, "text/plain; charset=utf-8", config.data); free(config.data as ptr<void>) }
            else { send_response(fd, 200, "text/plain; charset=utf-8", "") }
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/api/examples") {
            send_owned_response(fd, 200, "application/json; charset=utf-8", make_examples_json())
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/") or bytes_equal(bytes, request.path_start, request.path_end, "/index.html") {
            let page: FileRead = io_read_file("ui/index.html")
            if page.ok { send_response(fd, 200, "text/html; charset=utf-8", page.data); free(page.data as ptr<void>) }
            else { send_response(fd, 500, "text/plain; charset=utf-8", "Could not read ui/index.html") }
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/studio.css") {
            let stylesheet: FileRead = io_read_file("ui/studio.css")
            if stylesheet.ok { send_response(fd, 200, "text/css; charset=utf-8", stylesheet.data); free(stylesheet.data as ptr<void>) }
            else { send_response(fd, 500, "text/plain; charset=utf-8", "Could not read studio styles") }
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/favicon.svg") {
            let icon: FileRead = io_read_file("ui/favicon.svg")
            if icon.ok { send_response(fd, 200, "image/svg+xml", icon.data); free(icon.data as ptr<void>) }
            else { send_response(fd, 404, "text/plain", "Not found") }
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/renderer.js") {
            let renderer: FileRead = io_read_file("ui/renderer.js")
            if renderer.ok { send_response(fd, 200, "application/javascript; charset=utf-8", renderer.data); free(renderer.data as ptr<void>) }
            else { send_response(fd, 500, "text/plain; charset=utf-8", "Could not read ui/renderer.js") }
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/sea_urchin_project.json.gz") or bytes_equal(bytes, request.path_start, request.path_end, "/ui/sea_urchin_project.json.gz") {
            let gz_data: FileRead = io_read_file("ui/sea_urchin_project.json.gz")
            if gz_data.ok { send_file_read_response(fd, 200, "application/gzip", gz_data, "") }
            else { send_response(fd, 404, "text/plain", "Not found") }
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/sea_urchin_gastrulation.mp4") or bytes_equal(bytes, request.path_start, request.path_end, "/build/sea_urchin_video/sea_urchin_gastrulation.mp4") {
            let video_data: FileRead = io_read_file("ui/assets/sea_urchin_gastrulation.mp4")
            if video_data.ok { send_file_read_response(fd, 200, "video/mp4", video_data, "") }
            else { send_response(fd, 404, "text/plain", "Not found") }
            return
        }
        if bytes_equal(bytes, request.path_start, request.path_end, "/sea_urchin_project.json") or bytes_equal(bytes, request.path_start, request.path_end, "/ui/sea_urchin_project.json") {
            let project_data: FileRead = io_read_file("ui/sea_urchin_project.json.gz")
            if project_data.ok { send_file_read_response(fd, 200, "application/json; charset=utf-8", project_data, "gzip") }
            else { send_response(fd, 404, "text/plain", "Not found") }
            return
        }
        send_response(fd, 404, "text/plain; charset=utf-8", "Not found")
        return
    }
    if bytes_equal(bytes, request.method_start, request.method_end, "POST") {
        request_wants_binary = json_true(body, body_len, "binary")
        if bytes_equal(bytes, request.path_start, request.path_end, "/api/session") { handle_start(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/edit") { handle_node_edit(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/cell-edit") { handle_cell_edit(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/node-move") { handle_node_move(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/cell-move") { handle_cell_move(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/node-delete") { handle_node_delete(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/cell-delete") { handle_cell_delete(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/ecm-add") { handle_ecm_add(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/node-add") { handle_node_add(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/cell-add") { handle_basic_cell_add(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/node-paste") { handle_node_paste(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/cell-paste") { handle_cell_paste(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/gene-edit") { handle_gene_edit(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/advance") { handle_advance(fd, body, body_len); return }
        if bytes_equal(bytes, request.path_start, request.path_end, "/api/compute") { handle_compute(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/slice-plot") { handle_slice_plot(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/save") { handle_save_snapshot(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/save-image") { handle_save_image(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/save-movie") { handle_save_movie(fd, body, body_len); return }
        if session_path_is(bytes, request.path_start, request.path_end, "/close") {
            session_active = false
            send_response(fd, 200, "application/json; charset=utf-8", "{\"closed\":true}")
            return
        }
    }
    send_response(fd, 404, "application/json; charset=utf-8", "{\"error\":\"Not found\"}")
}

function main() -> i32 {
    embryomaker_ignore_sigpipe()
    let port_text: string = proc_getenv("PORT")
    let port: i32 = if port_text == "" { 8765 } else { str_parse_i64_at(port_text, 0).value as i32 }
    if port < 1 or port > 65535 { println("PORT must be between 1 and 65535"); return 2 }
    snapshot_file = "/tmp/embryomaker-flow-" + format_i64(proc_pid() as i64) + "-snapshot.dat"
    rollback_file = "/tmp/embryomaker-flow-" + format_i64(proc_pid() as i64) + "-rollback.dat"
    let worker_threads: i32 = parallel_init()
    let listener: i32 = embryomaker_loopback_listen(port)
    if listener < 0 { println("Could not open EmbryoMaker Studio HTTP listener"); return 1 }
    println("EmbryoMaker Studio (Flow) at http://127.0.0.1:" + format_i64(port as i64) + " with " + format_i64(worker_threads as i64) + " worker thread(s)")
    while true {
        let client: i32 = flow_rt_tcp_accept(listener)
        if client >= 0 {
            if embryomaker_configure_client(client) < 0 {
                let _closed: i32 = flow_rt_tcp_close(client)
                continue
            }
            let request: HttpRequest = read_request(client)
            if request.valid { route_request(client, request) }
            else { send_response(client, 400, "text/plain; charset=utf-8", "Bad request") }
            if request.bytes != null { free(request.bytes as ptr<void>) }
            let _c: i32 = flow_rt_tcp_close(client)
        }
    }
    return 0
}
